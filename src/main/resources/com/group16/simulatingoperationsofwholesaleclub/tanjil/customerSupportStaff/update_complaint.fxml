<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="567.0" prefWidth="831.0" spacing="30" style="-fx-background-color: #F4F6F9; -fx-padding: 40;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.UpdateComplaintController">

    <!-- Title -->
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Update Complaints" />

    <!-- Card Container -->
    <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30;">
        <effect>
            <DropShadow offsetY="4" radius="15" />
        </effect>

        <!-- Customer Name Search -->
        <HBox alignment="CENTER" spacing="15">
            <Label text="Customer Name:" />
            <TextField fx:id="customerNameField" prefWidth="300" />
            <Button onAction="#handleSearchComplaint" prefHeight="30" prefWidth="120" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Search" />
        </HBox>

        <!-- TableView -->
        <TableView fx:id="complaintsTable" prefHeight="250" prefWidth="600">
            <columns>
                <TableColumn fx:id="colTitle" prefWidth="200" text="Title" />
                <TableColumn fx:id="colDescription" prefWidth="250" text="Description" />
                <TableColumn fx:id="colStatus" prefWidth="150" text="Status" />
            </columns>
        </TableView>

        <!-- Message Label -->
        <Label fx:id="messageLabel" style="-fx-font-weight: bold; -fx-font-size: 14px;" textFill="#1976D2" />

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="40">
            <Button onAction="#handleMarkAsSolved" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Mark as Solved" />

            <Button onAction="#handleBackCSD" prefHeight="40" prefWidth="120" style="-fx-background-color: white; -fx-border-color: #1976D2; -fx-text-fill: #1976D2; -fx-background-radius: 8; -fx-font-weight: bold;" text="Back" />
        </HBox>
    </VBox>
</VBox>
