<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.StaffShiftController">

    <Label layoutX="210" layoutY="20" style="-fx-font-size: 20px; -fx-text-fill: #004aad;" text="Assign Staff Shift" />

    <Label layoutX="80" layoutY="80" style="-fx-text-fill: #004aad;" text="Staff ID:" />
    <TextField fx:id="staffIdTF" layoutX="150" layoutY="75" prefWidth="150" promptText="Enter Staff ID" />

    <Label layoutX="320" layoutY="80" style="-fx-text-fill: #004aad;" text="Date:" />
    <DatePicker fx:id="shiftDateDP" layoutX="360" layoutY="75" prefWidth="150" />

    <Label layoutX="80" layoutY="130" style="-fx-text-fill: #004aad;" text="Shift Time:" />
    <TextField fx:id="shiftTimeTF" layoutX="150" layoutY="125" prefWidth="150" promptText="e.g. 9 AM - 5 PM" />

    <Button layoutX="80.0" layoutY="208.0" onAction="#assignShiftBTN" prefWidth="150" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Assign Shift" />

    <Button layoutX="260" layoutY="340" onAction="#backBTN" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" />
   <Label fx:id="successLabel" layoutX="312.0" layoutY="270.0" prefHeight="18.0" prefWidth="198.0" />

</AnchorPane>
