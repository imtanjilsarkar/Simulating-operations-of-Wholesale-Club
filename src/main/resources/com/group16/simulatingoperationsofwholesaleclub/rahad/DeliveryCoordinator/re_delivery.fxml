<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.DeliveryCoordinator.controller.ReDeliveryRequestController">


    <Label layoutX="150.0" layoutY="10.0" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#004aad;" text="Request Re-Delivery" />


    <Label layoutX="31.0" layoutY="72.0" text="Order ID:" />

    <TextField fx:id="orderIdField" layoutX="176.0" layoutY="68.0" prefWidth="200.0" />


    <Label layoutX="31.0" layoutY="144.0" text="Reason for Re-Delivery:" />

    <TextArea fx:id="reasonField" layoutX="176.0" layoutY="100.0" prefHeight="138.0" prefWidth="366.0" wrapText="true" />

    <Label fx:id="stockStatusLabel" layoutX="20.0" layoutY="273.0" style="-fx-text-fill:#28a745;" text="Stock Availability: Unknown" />

    <Button layoutX="18.0" layoutY="339.0" onAction="#handleSaveRequest" prefWidth="150" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Submit Request" />


    <Label fx:id="statusLabel" layoutX="18.0" layoutY="307.0" prefWidth="550.0" text="" textFill="RED" wrapText="true" />


    <Button layoutX="196.0" layoutY="339.0" onAction="#handleBack" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" />

</AnchorPane>
