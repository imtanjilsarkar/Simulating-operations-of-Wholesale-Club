<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.membershipManager.controller.MembershipReportsController">

    <Label layoutX="220" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill:#004aad;" text="Membership Reports" />

    <Button layoutX="50.0" layoutY="374.0" onAction="#GeneratePDFBTN" prefWidth="130" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Generate PDF" />


    <TableView fx:id="reportTable" layoutX="50.0" layoutY="75.0" prefHeight="260" prefWidth="600" style="-fx-border-color:#007bff; -fx-background-color:white;">

        <columns>
            <TableColumn fx:id="idCol" prefWidth="90" text="ID" />
            <TableColumn fx:id="nameCol" prefWidth="170" text="Name" />
            <TableColumn fx:id="statusCol" prefWidth="170" text="Status" />
            <TableColumn fx:id="validTillCol" prefWidth="170" text="Valid Till" />
        </columns>

    </TableView>


    <Label fx:id="successLabel" layoutX="50.0" layoutY="342.0" prefWidth="600" style="-fx-font-size: 14px;" textFill="#004aad" />

    <Button layoutX="310" layoutY="400" onAction="#BackBTN" prefWidth="80" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Back" />

</AnchorPane>
