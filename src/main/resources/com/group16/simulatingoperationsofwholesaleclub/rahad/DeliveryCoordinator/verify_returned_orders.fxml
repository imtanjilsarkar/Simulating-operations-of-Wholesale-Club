<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: #ffffff;"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.DeliveryCoordinator.controller.VerifyReturnedOrdersController">

    <Label layoutX="180.0" layoutY="10.0" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#004aad;"
           text="Verify Returned Orders"/>

    <Label layoutX="20.0" layoutY="50.0" text="Enter Order ID:"/>

    <TextField fx:id="orderIdField" layoutX="130.0" layoutY="45.0" prefWidth="200.0"/>

    <Button layoutX="350.0" layoutY="45.0" onAction="#handleVerify" prefWidth="120"
            style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Verify Return"/>

    <TextArea fx:id="returnTextArea" layoutX="10.0" layoutY="90.0" prefHeight="300.0" prefWidth="580.0"
              editable="false" wrapText="true"/>

    <Label fx:id="statusLabel" layoutX="10.0" layoutY="400.0" prefWidth="580.0" text="" textFill="RED"
           wrapText="true"/>

    <Button layoutX="14.0" layoutY="420.0" onAction="#handleBack" prefWidth="80"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back"/>

</AnchorPane>
