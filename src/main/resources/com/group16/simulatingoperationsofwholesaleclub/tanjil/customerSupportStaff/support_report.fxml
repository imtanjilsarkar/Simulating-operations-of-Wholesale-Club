<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.SupportReportController">

    <!-- Title -->
    <Label layoutX="280.0" layoutY="40.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Pending Complaints" />

    <!-- TableView -->
    <TableView fx:id="tblReports" layoutX="150.0" layoutY="100.0" prefHeight="300.0" prefWidth="500.0">
        <columns>
            <TableColumn fx:id="colCustomerName" prefWidth="250" text="Customer Name" />
            <TableColumn fx:id="colStatus" prefWidth="250" text="Status" />
        </columns>
    </TableView>

    <!-- Load Button -->
    <Button layoutX="300.0" layoutY="420.0" onAction="#handleLoadComplaints" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Load" />

    <!-- Back Button -->
    <Button layoutX="480.0" layoutY="420.0" onAction="#handleBackCSD" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #0078D7; -fx-text-fill: #0078D7; -fx-background-radius: 8;" text="Back" />

    <!-- Message Label -->
    <Label fx:id="messageLabel" layoutX="150.0" layoutY="420.0" prefWidth="120.0" />

</AnchorPane>
