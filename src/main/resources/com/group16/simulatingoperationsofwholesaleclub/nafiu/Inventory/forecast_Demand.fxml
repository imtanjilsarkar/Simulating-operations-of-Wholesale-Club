<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500" prefWidth="850" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Inventory.Controller.Forecast_Demand">

    <children>

        <Label layoutX="310" layoutY="20" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Forecast Demand" />

        <Button layoutX="60" layoutY="100" onAction="#handleForecast" prefWidth="250"  text="Generate Forecast Report" />

        <Label layoutX="60" layoutY="160" text="Past Sales Data:" />

        <Label layoutX="60" layoutY="290" text="Demand Forecast (Next 4 Days):" />

        <TextArea fx:id="forecastArea" editable="false" layoutX="60" layoutY="320" prefHeight="110" prefWidth="720"  />

        <Button layoutX="60" layoutY="450" onAction="#goBack" prefWidth="100"  text="Back" />

        <TextField fx:id="pastdata" layoutX="60.0" layoutY="177.0" prefHeight="110.0" prefWidth="720.0" />

    </children>

</AnchorPane>
