<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #ECEFF1;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.HRManagerDashboardController">

    <!-- Center Card Panel -->
    <VBox alignment="TOP_CENTER" layoutX="204.0" layoutY="45.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">

        <!-- Drop Shadow -->
        <effect>
            <DropShadow color="#00000033" offsetX="0" offsetY="5" radius="15" />
        </effect>

        <!-- Title -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="HR Manager Dashboard" />

        <!-- Subtitle -->
        <Label style="-fx-font-size: 14px; -fx-text-fill: #616161;" text="Select an option below to continue" />

        <!-- Grid of Buttons -->
        <GridPane hgap="30" vgap="20">

            <!-- Row 1 -->
            <Button onAction="#handleRecruitment" prefHeight="50" prefWidth="200" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Recruitment" />
            <Button onAction="#handleUpdateEmployee" prefHeight="50" prefWidth="200" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Update Employee" GridPane.columnIndex="1" />

            <!-- Row 2 -->
            <Button onAction="#handleAttendance" prefHeight="50" prefWidth="200" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Attendance" GridPane.rowIndex="1" />
            <Button onAction="#handlePayroll" prefHeight="50" prefWidth="200" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Payroll" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <!-- Row 3 -->
            <Button onAction="#handleLeaveRequest" prefHeight="50" prefWidth="200" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Leave Request" GridPane.rowIndex="2" />
            <Button onAction="#handleLeaveApproval" prefHeight="50" prefWidth="200" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Leave Approval" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <!-- Row 4 -->
            <Button onAction="#handleRemoveEmployee" prefHeight="50" prefWidth="200" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Remove Employee" GridPane.rowIndex="3" />
            <Button onAction="#handleSummaryReport" prefHeight="50" prefWidth="200" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Summary Report" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>

        </GridPane>

        <!-- Back & Logout -->
        <GridPane hgap="20" layoutY="20">
            <Button onAction="#handleBack" prefHeight="40" prefWidth="198.0" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Back" />
            <Button onAction="#handleLogout" prefHeight="40" prefWidth="213.0" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand;" text="Logout" GridPane.columnIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>

    </VBox>

    <!-- Footer -->
    <Label layoutX="300.0" layoutY="570.0" style="-fx-font-size: 12px; -fx-text-fill: #999999;" text="© 2026 Wholesale Club Management System" />

</AnchorPane>
