<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F9FAFB;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Handle_Returns_or_Refunds">

    <!-- Back Button -->
    <Button layoutX="30.0" layoutY="30.0" prefWidth="100.0" text="Back"
            onAction="#handleBack"
            style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />

    <!-- Header -->
    <Label layoutX="160.0" layoutY="40.0"
           style="-fx-font-size: 22px; -fx-text-fill: #0078D7; -fx-font-weight: bold;"
           text="Handle Returns and Refunds" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" stroke="#0078D7" strokeWidth="2" />

    <!-- Content Section -->
    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <!-- Step 1: Select Return Item -->
        <Button text="Return Item" prefWidth="200.0"
                onAction="#handleSelectReturnItem"
                style="-fx-background-color: #005EA6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />

        <!-- Step 2: Enter Product ID and Bill Number -->
        <VBox spacing="5.0">
            <Label text="Enter Product ID:"
                   style="-fx-text-fill: #0078D7; -fx-font-size: 14px; -fx-font-weight: bold;" />
            <TextField fx:id="productIdField" prefWidth="300.0" />

            <Label text="Enter Bill Number:"
                   style="-fx-text-fill: #0078D7; -fx-font-size: 14px; -fx-font-weight: bold;" />
            <TextField fx:id="billNoField" prefWidth="300.0" />

            <Button prefWidth="150.0" text="Verify Item"
                    onAction="#handleVerifyReturnItem"
                    style="-fx-background-color: #005EA6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />
        </VBox>

        <!-- Step 3: Eligibility Verification -->
        <Label fx:id="eligibilityLabel" text="Eligibility: Not Checked"
               style="-fx-text-fill: #333; -fx-font-size: 16px;" />

        <!-- Step 4: Process Refund Amount -->
        <Label fx:id="refundAmountLabel" text="Refund Amount: Not Calculated"
               style="-fx-text-fill: #333; -fx-font-size: 16px;" />

        <!-- Step 5: Display Refund Confirmation -->
        <Label fx:id="refundConfirmationLabel" text="Refund Status: Pending"
               style="-fx-text-fill: #333; -fx-font-size: 16px;" />

    </VBox>

</AnchorPane>
