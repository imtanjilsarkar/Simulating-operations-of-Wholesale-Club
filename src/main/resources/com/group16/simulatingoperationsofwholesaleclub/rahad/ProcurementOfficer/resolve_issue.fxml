<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="506.0" prefWidth="739.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.ResolveIssuesWithSupplierController">

    <!-- Title -->
    <Label layoutX="186.0" layoutY="14.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Resolve Supplier Issues" />

    <!-- Load Damaged Products Button -->
    <Button layoutX="35.0" layoutY="450.0" onAction="#loadDamagedProducts" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Load Damaged Products" />

    
    <TableView fx:id="damagedTable" layoutX="74.0" layoutY="63.0" prefHeight="249.0" prefWidth="561.0">

        <columns>
            <TableColumn fx:id="colProductID" prefWidth="120.0" text="Product ID" />
            <TableColumn fx:id="colProductName" prefWidth="152.79998779296875" text="Product Name" />
            <TableColumn fx:id="deductedQTYcol" prefWidth="117.59994506835938" text="Deducted quantity" />
         <TableColumn fx:id="colReason" prefWidth="170.4000244140625" text="Reason" />
        </columns>
    </TableView>


    <TextArea fx:id="remarksArea" layoutX="89.0" layoutY="350.0" prefHeight="90.0" prefWidth="547.0" promptText="Optional remarks for replacement request..." style="-fx-border-color:#007bff; -fx-border-radius:5;" />


    <Button layoutX="199.0" layoutY="450.0" onAction="#sendReplacementRequest" prefHeight="35.0" prefWidth="138.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Send Request" />


    <Label fx:id="confirmationLabel" layoutX="186.0" layoutY="320.0" prefHeight="18.0" prefWidth="266.0" style="-fx-text-fill: green; -fx-font-weight: bold;" text="" />


    <Button layoutX="355.0" layoutY="452.0" onAction="#handleBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
