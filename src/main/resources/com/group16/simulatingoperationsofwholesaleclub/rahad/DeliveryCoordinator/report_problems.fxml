<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.DeliveryCoordinator.controller.ReportDeliveryProblemsController">


    <Label layoutX="180.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Report Delivery Problem" />


    <Label layoutX="50.0" layoutY="80.0" text="Order ID:" />
    <TextField fx:id="orderIdField" layoutX="150.0" layoutY="75.0" prefWidth="250.0" />


    <Label layoutX="50.0" layoutY="130.0" text="Problem Details:" />
    <TextArea fx:id="problemDetailsTA" layoutX="150.0" layoutY="125.0" prefHeight="120.0" prefWidth="300.0" />


    <Button layoutX="150.0" layoutY="270.0" onAction="#handleSubmitProblem" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Submit Problem" />


    <Button layoutX="320.0" layoutY="270.0" onAction="#handleBack" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Back" />


    <Label fx:id="statusLabel" layoutX="50.0" layoutY="320.0" prefWidth="500.0" textFill="RED" wrapText="true" />

</AnchorPane>
