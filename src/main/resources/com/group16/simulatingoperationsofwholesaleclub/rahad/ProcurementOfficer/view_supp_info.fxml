<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="300.0" prefWidth="500.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.ViewSupplierContactController">

    <Label layoutX="140.0" layoutY="14.0"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;"
           text="View Supplier Contact" />

    <Label layoutX="20.0" layoutY="60.0" text="Supplier ID:" />
    <TextField fx:id="supplierIdField" layoutX="120.0" layoutY="55.0" prefWidth="200"
               promptText="Enter Supplier ID" />

    <Button layoutX="340.0" layoutY="55.0"
            onAction="#handleSearchButton"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;"
            text="Search" />

    <Label layoutX="20.0" layoutY="100.0" text="Supplier Information:" />
    <TextArea fx:id="supplierInfoArea" layoutX="20.0" layoutY="125.0" prefWidth="460" prefHeight="120"
              editable="false" wrapText="true" />

    <Button layoutX="20.0" layoutY="260.0"
            onAction="#handleBack"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;"
            text="Back" />

    <Label fx:id="messageLabel" layoutX="140" layoutY="260" prefWidth="340"
           style="-fx-text-fill: red;" text="" />

</AnchorPane>
