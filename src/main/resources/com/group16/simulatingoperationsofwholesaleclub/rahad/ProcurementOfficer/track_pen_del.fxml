<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.TrackPendingSupplierDeliveriesController">


    <Label layoutX="140.0" layoutY="20.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Pending Supplier Deliveries" />


    <Button layoutX="30.0" layoutY="59.0" onAction="#loadPendingDeliveries" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Load Pending Deliveries" />


    <TableView fx:id="pendingTable" layoutX="30.0" layoutY="110.0" prefHeight="180.0" prefWidth="546.0">

        <columns>
            <TableColumn fx:id="colDeliveryID" prefWidth="120.0" text="Delivery ID" />
            <TableColumn fx:id="colSupplierName" prefWidth="160.00006103515625" text="Supplier Name" />
            <TableColumn fx:id="colProduct" prefWidth="131.199951171875" text="Product" />
            <TableColumn fx:id="colDueDate" prefWidth="134.4000244140625" text="Due Date" />
        </columns>
    </TableView>


    <TextArea fx:id="remarksArea" editable="false" layoutX="50.0" layoutY="300.0" prefHeight="50.0" prefWidth="500.0" promptText="Remarks / notifications will appear here..." style="-fx-border-color:#007bff; -fx-border-radius:5;" />


    <Button layoutX="20.0" layoutY="355.0" onAction="#handleBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
