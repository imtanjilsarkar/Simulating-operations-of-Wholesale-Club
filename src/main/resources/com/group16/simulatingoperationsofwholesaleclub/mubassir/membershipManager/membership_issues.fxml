<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.membershipManager.controller.MembershipIssuesController">

    <Label layoutX="200" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill:#004aad;" text="Membership Issues" />

    <Label layoutX="52.0" layoutY="130.0" style="-fx-text-fill:#004aad;" text="Issue Description:" />
    <TextArea fx:id="issueTA" layoutX="160.0" layoutY="110.0" prefHeight="120" prefWidth="300" style="-fx-border-color:#007bff;" />

    <Button layoutX="170" layoutY="280" onAction="#loadIssueBTN" prefWidth="140" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Load Issue" />

    <Button layoutX="330" layoutY="280" onAction="#BackBTN" prefWidth="80" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Back" />

</AnchorPane>
