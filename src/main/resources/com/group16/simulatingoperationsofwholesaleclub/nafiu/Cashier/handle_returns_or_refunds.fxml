<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Handle_Returns_or_Refunds">

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="561.0" onAction="#handleBack" prefWidth="100.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Back" />

    <!-- Header -->
    <Label layoutX="160.0" layoutY="40.0" style="-fx-font-size: 22px; -fx-text-fill: #0078D7; -fx-font-weight: bold;" text="Handle Returns and Refunds" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" stroke="#0078D7" strokeWidth="2" />

    <!-- Content Section -->
    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <!-- Step 2: Enter Product ID and Bill Number -->
        <VBox spacing="5.0">
            <Label style="-fx-text-fill: #0078D7; -fx-font-size: 14px; -fx-font-weight: bold;" text="Enter Product ID:" />
            <TextField fx:id="productIdField" prefWidth="300.0" />

            <Label style="-fx-text-fill: #0078D7; -fx-font-size: 14px; -fx-font-weight: bold;" text="Enter Bill Number:" />
            <TextField fx:id="billNoField" prefWidth="300.0" />

            <Button onAction="#handleVerifyReturnItem" prefWidth="150.0" style="-fx-background-color: #005EA6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Verify Item" />
        </VBox>

        <!-- Step 3: Eligibility Verification -->
        <Label fx:id="eligibilityLabel" style="-fx-text-fill: #333; -fx-font-size: 16px;" text="Eligibility: Not Checked" />

        <!-- Step 4: Process Refund Amount -->
        <Label fx:id="refundAmountLabel" style="-fx-text-fill: #333; -fx-font-size: 16px;" text="Refund Amount: Not Calculated" />

        <!-- Step 5: Display Refund Confirmation -->
        <Label fx:id="refundConfirmationLabel" style="-fx-text-fill: #333; -fx-font-size: 16px;" text="Refund Status: Pending" />

    </VBox>

</AnchorPane>
