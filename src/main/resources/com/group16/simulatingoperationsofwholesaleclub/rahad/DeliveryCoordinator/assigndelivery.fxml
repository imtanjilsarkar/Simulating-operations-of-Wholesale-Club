<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.deliveryCoordinator.controller.AssignDeliveryTasksController">


    <Button layoutX="165.0" layoutY="325.0" onAction="#ViewOrdersBTN" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="View Orders" />


    <TableView fx:id="ordersTable" layoutX="10.0" layoutY="60.0" prefHeight="190.0" prefWidth="550.0">
        <columns>
            <TableColumn fx:id="orderIdCol" prefWidth="100" text="Order ID" />
            <TableColumn fx:id="customerNameCol" prefWidth="150" text="Customer Name" />
            <TableColumn fx:id="productListCol" prefWidth="200" text="Product List" />
            <TableColumn fx:id="quantityCol" prefWidth="100" text="Quantity" />
        </columns>
    </TableView>


    <Label layoutX="20.0" layoutY="280.0" style="-fx-text-fill:#004aad;" text="Select Delivery Staff:" />


    <ComboBox fx:id="staffComboBox" layoutX="150.0" layoutY="275.0" prefWidth="200.0" style="-fx-border-color:#007bff;" />


    <Button layoutX="380.0" layoutY="275.0" onAction="#AssignDeliveryBTN" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Assign Delivery" />

    <Label fx:id="statusLabel" layoutX="20.0" layoutY="320.0" prefWidth="560.0" text="" textFill="RED" wrapText="true" />

</AnchorPane>
