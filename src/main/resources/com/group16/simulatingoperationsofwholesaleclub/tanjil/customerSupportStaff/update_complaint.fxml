<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.UpdateComplaintController">

    <!-- Title -->
    <Label layoutX="250.0" layoutY="40.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Update Complaints" />

    <!-- Customer Name -->
    <Label layoutX="150.0" layoutY="100.0" text="Customer Name:" />
    <TextField fx:id="customerNameField" layoutX="300.0" layoutY="96.0" prefWidth="300.0" />

    <!-- Search Button -->
    <Button layoutX="620.0" layoutY="96.0" onAction="#handleSearchComplaint" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Search" />

    <!-- TableView -->
    <TableView fx:id="complaintsTable" layoutX="150.0" layoutY="150.0" prefHeight="250.0" prefWidth="600.0">
        <columns>
            <TableColumn fx:id="colTitle" text="Title" prefWidth="200.0"/>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="250.0"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="150.0"/>
        </columns>
    </TableView>

    <!-- Mark as Solved Button -->
    <Button layoutX="300.0" layoutY="420.0" onAction="#handleMarkAsSolved" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Mark as Solved" />

    <!-- Message Label -->
    <Label fx:id="messageLabel" layoutX="300.0" layoutY="370.0" prefHeight="18.0" prefWidth="300.0" />

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="460.0" onAction="#handleBackCSD" prefHeight="18.0" prefWidth="56.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
