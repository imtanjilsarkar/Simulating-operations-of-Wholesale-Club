<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.Label?>

<?import javafx.scene.control.TableColumn?>

<?import javafx.scene.control.TableView?>

<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.deliveryCoordinator.controller.ManageDeliveryScheduleController">


    <Label layoutX="200.0" layoutY="10.0" text="Manage Delivery Schedule" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#004aad;" />


    <Button layoutX="14.0" layoutY="40.0" onAction="#ViewScheduleBTN" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="View Schedule" />


    <TableView fx:id="scheduleTable" layoutX="10.0" layoutY="80.0" prefHeight="240.0" prefWidth="550.0">
        <columns>
            <TableColumn fx:id="colOrderID" prefWidth="120" text="Order ID" />
            <TableColumn fx:id="colDriver" prefWidth="150" text="Driver Name" />
            <TableColumn fx:id="colDate" prefWidth="140" text="Delivery Date" />
            <TableColumn fx:id="colTime" prefWidth="140" text="Delivery Time" />
        </columns>
    </TableView>


    <Label fx:id="statusLabel" layoutX="5.0" layoutY="330.0" prefWidth="560.0" text="" textFill="RED" wrapText="true" />


    <Button layoutX="14.0" layoutY="360.0" onAction="#handleBack" prefWidth="80" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Back" />

</AnchorPane>
