<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.StaffActivitiesController">


    <Label layoutX="210" layoutY="20" style="-fx-font-size: 20px; -fx-text-fill: #004aad;" text="Staff Activity Audit" />


    <Label layoutX="80" layoutY="80" style="-fx-text-fill: #004aad;" text="Staff ID:" />
    <TextField fx:id="staffIdTF" layoutX="150" layoutY="75" prefWidth="150" promptText="Enter Staff ID" />


    <Label layoutX="320" layoutY="80" style="-fx-text-fill: #004aad;" text="Date:" />
    <DatePicker fx:id="dateDP" layoutX="360" layoutY="75" prefWidth="150" />


    <Button layoutX="230" layoutY="130" onAction="#viewActivitiesBTN" prefWidth="150" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="View Activities" />


    <TextArea fx:id="activityOutputTA" layoutX="80" layoutY="180" prefHeight="180" prefWidth="440" promptText="Activity details will appear here..." style="-fx-border-color: #007bff;" />


    <Button layoutX="260" layoutY="370" onAction="#backBTN" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" />

</AnchorPane>
