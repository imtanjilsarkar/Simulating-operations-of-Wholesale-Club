<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.membershipManager.controller.NewMembershipController">

    <Label layoutX="160" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill:#004aad;" text="New Membership Registration" />


    <Label layoutX="40" layoutY="80" style="-fx-text-fill:#004aad;" text="Customer Name:" />
    <TextField fx:id="customerNameTF" layoutX="170" layoutY="75" prefWidth="200" style="-fx-border-color:#007bff;" />


    <Label layoutX="40" layoutY="130" style="-fx-text-fill:#004aad;" text="Membership Type:" />
    <ComboBox fx:id="membershipTypeCB" layoutX="170" layoutY="125" prefWidth="200" style="-fx-border-color:#007bff;" />

    <Label layoutX="40" layoutY="180" style="-fx-text-fill:#004aad;" text="Valid Till:" />
    <DatePicker fx:id="validTillDP" layoutX="170" layoutY="175" prefWidth="200" style="-fx-border-color:#007bff;" />


    <Label layoutX="40" layoutY="230" style="-fx-text-fill:#004aad;" text="Customer ID:" />
    <TextField fx:id="customerIdTF" editable="false" layoutX="170" layoutY="225" prefWidth="200" promptText="Click Generate" style="-fx-border-color:#007bff; -fx-opacity:0.8;" />


    <Button layoutX="380" layoutY="225" onAction="#generateIDBTN" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Generate ID" />

    <Button layoutX="88.0" layoutY="334.0" onAction="#RegisterBTN" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Register" />


    <Button layoutX="420.0" layoutY="334.0" onAction="#BackBTN" prefWidth="80" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Back" />
   <Label fx:id="successLabel" layoutX="50.0" layoutY="282.0" prefHeight="18.0" prefWidth="287.0" />

</AnchorPane>
