<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"  xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Handle_Returns_or_Refunds">

    <Button layoutX="14.0" layoutY="561.0" onAction="#handleBack" prefWidth="100.0"  text="Back" />

    <Label layoutX="160.0" layoutY="40.0"  text="Handle Returns and Refunds" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0"  />

    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <VBox spacing="5.0">
            <Label  text="Enter Product ID:" />
            <TextField fx:id="productIdField" prefWidth="300.0" />

            <Label  text="Enter Bill Number:" />
            <TextField fx:id="billNoField" prefWidth="300.0" />

            <Button onAction="#handleVerifyReturnItem" prefWidth="150.0"  text="Verify Item" />
        </VBox>

        <Label fx:id="eligibilityLabel"  text="Eligibility: Not Checked" />

        <Label fx:id="refundAmountLabel"  text="Refund Amount: Not Calculated" />

        <Label fx:id="refundConfirmationLabel"  text="Refund Status: Pending" />

    </VBox>

</AnchorPane>
