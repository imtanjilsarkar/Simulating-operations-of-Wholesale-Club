<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.TopManagementReportsController">

    <Label layoutX="200" layoutY="30" style="-fx-font-size: 18px; -fx-text-fill: #004aad;" text="Management Report" />


    <Label layoutX="140" layoutY="100" style="-fx-text-fill: #004aad;" text="Date:" />
    <DatePicker fx:id="reportDateDP" layoutX="180" layoutY="95" prefWidth="250" />


    <Button layoutX="240" layoutY="150" onAction="#showReportBTN" prefWidth="120" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Show Report" />

    <TextArea fx:id="reportOutputTA" layoutX="80" layoutY="200" prefHeight="150" prefWidth="440" promptText="Report will appear here..." style="-fx-border-color: #007bff;" />


    <Button layoutX="260" layoutY="360" onAction="#backBTN" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Back" />

</AnchorPane>
