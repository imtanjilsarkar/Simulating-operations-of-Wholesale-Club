<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.ApprovePurchaseController">


    <Label layoutX="20" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Approve Purchase Order" />


    <Label layoutX="20" layoutY="80" style="-fx-text-fill:#004aad;" text="Request ID:" />
    <TextField fx:id="requestIdTF" layoutX="150" layoutY="75" prefWidth="200" style="-fx-border-color:#007bff;" />


    <Label layoutX="20" layoutY="130" style="-fx-text-fill:#004aad;" text="Request Details:" />
    <TextArea fx:id="requestDetailsTF" layoutX="150" layoutY="125" prefHeight="120" prefWidth="300" style="-fx-border-color:#007bff;" />


    <Button layoutX="150" layoutY="270" onAction="#approveBTN" prefWidth="100" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 5;" text="Approve" />


    <Button layoutX="260" layoutY="270" onAction="#rejectBTN" prefWidth="100" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 5;" text="Reject" />


    <Button layoutX="370" layoutY="270" onAction="#backBTN" prefWidth="80" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 5;" text="Back" />

</AnchorPane>
