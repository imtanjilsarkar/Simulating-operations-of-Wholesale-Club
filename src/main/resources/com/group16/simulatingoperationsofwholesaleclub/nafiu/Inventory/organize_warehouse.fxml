<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500" prefWidth="850"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Inventory.Controller.Organize_Warehouse">

    <children>

        <!-- Title -->
        <Label text="Organize Warehouse"
               layoutX="300" layoutY="20"
               style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <!-- Step 1: Assign Storage Location -->
        <Label text="Product ID:" layoutX="60" layoutY="100" />
        <TextField fx:id="productIdField"
                   layoutX="160" layoutY="95"
                   prefWidth="250" />

        <Label text="Shelf Location:" layoutX="60" layoutY="150" />
        <TextField fx:id="shelfField"
                   layoutX="160" layoutY="145"
                   prefWidth="150" />

        <!-- Validate Location Button -->
        <Button text="Validate Location"
                layoutX="60" layoutY="200"
                prefWidth="180"
                onAction="#validateLocation"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;" />

        <!-- Update Placement Button -->
        <Button text="Update Placement"
                layoutX="260" layoutY="200"
                prefWidth="180"
                onAction="#updatePlacement"
                style="-fx-background-color: #FF9800; -fx-text-fill: white;" />

        <!-- Confirmation -->
        <Label text="Updated Storage Status:" layoutX="60" layoutY="260" />
        <TextArea fx:id="statusArea"
                  layoutX="60" layoutY="290"
                  prefWidth="720" prefHeight="140"
                  editable="false"
                  style="-fx-control-inner-background: #f0f0f0;" />

        <!-- Back Button -->
        <Button text="Back"
                layoutX="60" layoutY="450"
                prefWidth="100"
                onAction="#goBack"
                style="-fx-background-color: #777; -fx-text-fill: white;" />

    </children>

</AnchorPane>
