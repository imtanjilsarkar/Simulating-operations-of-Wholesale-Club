<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400" prefWidth="600" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.LeaveApprovalController">

    <TableView fx:id="leaveTable" layoutX="20" layoutY="20" prefHeight="280" prefWidth="560">
        <columns>
            <TableColumn fx:id="colEmpName" prefWidth="120" text="Employee Name" />
            <TableColumn fx:id="colLeaveType" prefWidth="120" text="Leave Type" />
            <TableColumn fx:id="colStartDate" prefWidth="100" text="Start Date" />
            <TableColumn fx:id="colEndDate" prefWidth="110.39996337890625" text="End Date" />
            <TableColumn fx:id="colStatus" prefWidth="108.800048828125" text="Status" />
        </columns>
    </TableView>

    <Button layoutX="50" layoutY="320" onAction="#handleLoadRequests" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Load Requests" />

    <Button layoutX="200" layoutY="320" onAction="#handleApprove" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Approve" />

    <Button layoutX="350" layoutY="320" onAction="#handleReject" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Reject" />

    <Label fx:id="outputMessage" layoutX="20" layoutY="360" prefWidth="560" style="-fx-text-fill: black;" />
</AnchorPane>
