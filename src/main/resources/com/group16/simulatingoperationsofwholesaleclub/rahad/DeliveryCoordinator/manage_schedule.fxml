<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.DeliveryCoordinator.controller.ManageDeliveryScheduleController">


    <Label layoutX="180.0" layoutY="10.0" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#004aad;" text="Manage Delivery Schedule" />


    <Label layoutX="50.0" layoutY="80.0" style="-fx-text-fill:#004aad;" text="Order ID:" />
    <TextField fx:id="orderIdField" layoutX="180.0" layoutY="75.0" prefWidth="200.0" style="-fx-border-color:#007bff;" />


    <Label layoutX="50.0" layoutY="130.0" style="-fx-text-fill:#004aad;" text="Previous Delivery Date:" />
    <TextField fx:id="prevDateField" editable="false" layoutX="180.0" layoutY="125.0" prefWidth="200.0" style="-fx-border-color:#007bff;" />


    <Label layoutX="50.0" layoutY="180.0" style="-fx-text-fill:#004aad;" text="Set New Date:" />
    <DatePicker fx:id="newDatePicker" layoutX="180.0" layoutY="175.0" prefWidth="200.0" style="-fx-border-color:#007bff;" />


    <Button layoutX="180.0" layoutY="230.0" onAction="#handleUpdateDate" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Update Date" />


    <Label fx:id="statusLabel" layoutX="50.0" layoutY="280.0" prefWidth="500.0" text="" textFill="green" wrapText="true" />


    <Button layoutX="480.0" layoutY="340.0" onAction="#handleBack" prefWidth="80" style="-fx-background-color:#6c757d; -fx-text-fill:white; -fx-background-radius:5;" text="Back" />
   <Button layoutX="386.0" layoutY="76.0" onAction="#searchID" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Search ID" />

</AnchorPane>
