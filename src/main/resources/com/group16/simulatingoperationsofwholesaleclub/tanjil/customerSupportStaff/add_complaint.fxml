<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="578.0" prefWidth="726.0" spacing="30" style="-fx-background-color: #F4F6F9; -fx-padding: 40;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.AddComplaintController">

    <!-- Title -->
    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Add New Complaint" />

    <!-- Card Container -->
    <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25;">
        <effect>
            <DropShadow offsetY="4" radius="15" />
        </effect>

        <!-- Customer Name -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Customer Name:" />
            <TextField fx:id="customerNameField" prefWidth="350" promptText="Enter customer name" />
        </HBox>

        <!-- Complaint Title -->
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label prefWidth="150" style="-fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Complaint Title:" />
            <TextField fx:id="complaintTitleField" prefWidth="350" promptText="Enter complaint title" />
        </HBox>

        <!-- Complaint Description -->
        <VBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Description:" />
            <TextArea fx:id="descriptionArea" prefHeight="150" prefWidth="500" promptText="Enter complaint description" />
        </VBox>

        <!-- Message Label -->
        <Label fx:id="messageLabel" textFill="#E53935" />

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="30">
            <Button onAction="#handleSubmitComplaint" prefHeight="40" prefWidth="140" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Submit" />
            <Button onAction="#handleCancel" prefHeight="40" prefWidth="140" style="-fx-background-color: white; -fx-border-color: #1976D2; -fx-text-fill: #1976D2; -fx-font-weight: bold; -fx-background-radius: 8;" text="Cancel" />
        </HBox>
    </VBox>

    <!-- Back Button -->
    <Button onAction="#handleBackCSD" prefHeight="30" prefWidth="80" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Back" />

</VBox>
