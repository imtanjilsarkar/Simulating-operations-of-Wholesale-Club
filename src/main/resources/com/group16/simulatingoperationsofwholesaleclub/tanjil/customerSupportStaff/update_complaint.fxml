<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.UpdateComplaintController">

    <!-- Title -->
    <Label layoutX="260.0" layoutY="40.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Update Complaint" />

    <!-- Customer Name -->
    <Label layoutX="150.0" layoutY="100.0" text="Customer Name:" />
    <TextField fx:id="customerNameField" layoutX="300.0" layoutY="95.0" prefWidth="300.0" />

    <!-- Search Button -->
    <Button layoutX="620.0" layoutY="95.0" onAction="#handleSearchComplaint" prefWidth="100.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Search" />

    <!-- Complaints List for Customer -->
    <Label layoutX="150.0" layoutY="150.0" text="Customer Complaints:" />
    <TextArea fx:id="complaintTitlesArea" layoutX="300.0" layoutY="145.0" prefHeight="100.0" prefWidth="300.0" editable="false" />

    <!-- Complaint Title to Update -->
    <Label layoutX="150.0" layoutY="270.0" text="Complaint Title:" />
    <TextField fx:id="complaintTitleField" layoutX="300.0" layoutY="265.0" prefWidth="300.0" />

    <!-- Complaint Description -->
    <Label layoutX="150.0" layoutY="320.0" text="Description:" />
    <TextArea fx:id="descriptionArea" layoutX="300.0" layoutY="315.0" prefHeight="150.0" prefWidth="300.0" />

    <!-- Update Button -->
    <Button layoutX="303.0" layoutY="490.0" onAction="#handleUpdateComplaint" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Update" />

    <!-- Cancel Button -->
    <Button layoutX="480.0" layoutY="490.0" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #0078D7; -fx-text-fill: #0078D7; -fx-background-radius: 8;" text="Cancel" />

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="520.0" onAction="#handleBackCSD" prefHeight="18.0" prefWidth="63.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Back" />

    <!-- Message Label -->
    <Label fx:id="messageLabel" layoutX="300.0" layoutY="480.0" prefHeight="18.0" prefWidth="300.0" />

</AnchorPane>
