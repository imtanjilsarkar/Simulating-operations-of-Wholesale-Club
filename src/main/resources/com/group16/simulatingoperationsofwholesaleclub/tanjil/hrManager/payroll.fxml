<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<VBox spacing="25"
      alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.PayrollController"
      style="-fx-background-color: #F4F6F9; -fx-padding: 30;">

    <!-- Title -->
    <Label text="Payroll Management"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />

    <!-- ================= EMPLOYEE TABLE CARD ================= -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 20;">

        <effect>
            <DropShadow radius="20" offsetY="4"/>
        </effect>

        <Label text="Employee Salary List"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TableView fx:id="employeeTable" prefHeight="280" prefWidth="720">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="90"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="160"/>
                <TableColumn fx:id="colDepartment" text="Department" prefWidth="150"/>
                <TableColumn fx:id="colPosition" text="Position" prefWidth="150"/>
                <TableColumn fx:id="colSalary" text="Salary" prefWidth="120"/>
            </columns>
        </TableView>

    </VBox>

    <!-- ================= UPDATE SALARY CARD ================= -->
    <VBox spacing="18"
          alignment="CENTER_LEFT"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <effect>
            <DropShadow radius="20" offsetY="4"/>
        </effect>

        <Label text="Update Salary"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <HBox spacing="15" alignment="CENTER_LEFT">

            <TextField fx:id="txtSalary"
                       promptText="Enter new salary"
                       prefWidth="200"/>

            <!-- Primary Action -->
            <Button text="Update Salary"
                    onAction="#handleUpdateSalary"
                    style="-fx-background-color: #1976D2;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;" />

            <!-- Secondary Action -->
            <Button text="Load Employees"
                    onAction="#handleLoadEmployees"
                    style="-fx-background-color: #E3F2FD;
                           -fx-text-fill: #1976D2;
                           -fx-background-radius: 8;" />

        </HBox>

        <Label fx:id="outputMessage"/>

    </VBox>

    <!-- Back Button -->
    <Button text="Back"
            onAction="#handleBackHRMD"
            style="-fx-background-color: #ECEFF1;
                   -fx-background-radius: 8;" />

</VBox>