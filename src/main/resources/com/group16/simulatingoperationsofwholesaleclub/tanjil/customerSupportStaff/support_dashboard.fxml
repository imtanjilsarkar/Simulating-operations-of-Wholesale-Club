<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="555.0" prefWidth="724.0" spacing="25" style="-fx-background-color: #F4F6F9; -fx-padding: 30;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.SupportDashboardController">

    <!-- Title -->
    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Customer Support Dashboard" />

    <!-- Button Cards -->
    <VBox alignment="CENTER" prefHeight="381.0" prefWidth="662.0" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
        <effect>
            <DropShadow offsetY="4" radius="20" />
        </effect>

        <GridPane alignment="CENTER" hgap="20" vgap="20">
            <Button onAction="#handleAddComplaint" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Add Complaint" />
            <Button onAction="#handleUpdateComplaint" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Update Complaint" GridPane.columnIndex="1" />

            <Button onAction="#handleCloseComplaint" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Close Complaint" GridPane.rowIndex="1" />
            <Button onAction="#handleOrderStatus" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Order Status" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Button onAction="#handleNewMembership" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="New Membership Request" GridPane.rowIndex="2" />
            <Button onAction="#handlePendingComplaint" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Pending Complaint" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Button onAction="#handleFeedback" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Feedback" GridPane.rowIndex="3" />
            <Button onAction="#handleSupportReport" prefHeight="40" prefWidth="200" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Support Report" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </VBox>

    <!-- Footer Buttons -->
    <HBox alignment="CENTER" spacing="20">
        <Button onAction="#handleBack" prefWidth="100" style="-fx-background-color: #ECEFF1; -fx-text-fill: #1976D2; -fx-font-weight: bold; -fx-background-radius: 8;" text="Back" />
        <Button onAction="#handleLogout" prefWidth="100" style="-fx-background-color: #ECEFF1; -fx-text-fill: #1976D2; -fx-font-weight: bold; -fx-background-radius: 8;" text="Logout" />
    </HBox>

    <!-- Footer Label -->
    <Label style="-fx-font-size: 12px; -fx-text-fill: #999999;" text="© 2025 Customer Support Staff" />

</VBox>
