<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.membershipManager.controller.RenewMembershipController">

    <Label layoutX="200" layoutY="20" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill:#004aad;" text="Renew Membership" />

    <Label layoutX="40" layoutY="80" style="-fx-text-fill:#004aad;" text="Membership ID:" />
    <TextField fx:id="membershipIdTF" layoutX="170" layoutY="75" prefWidth="200" style="-fx-border-color:#007bff;" />

    <Label layoutX="40" layoutY="180" style="-fx-text-fill:#004aad;" text="New Validation Date:" />
    <DatePicker fx:id="expiryDP" layoutX="170" layoutY="175" prefWidth="200" style="-fx-border-color:#007bff;" />

    <Button layoutX="102.0" layoutY="323.0" onAction="#RenewBTN" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Renew" />

    <Button layoutX="443.0" layoutY="329.0" onAction="#BackBTN" prefWidth="80" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Back" />
   <Label fx:id="successLabels" layoutX="102.0" layoutY="259.0" prefHeight="18.0" prefWidth="229.0" />
   <Label layoutX="32.0" layoutY="133.0" style="-fx-text-fill:#004aad;" text="Previous Validation Date:" />
   <TextField fx:id="previousdateTF" layoutX="170.0" layoutY="128.0" prefWidth="200" style="-fx-border-color:#007bff;" />
   <Button layoutX="403.0" layoutY="76.0" onAction="#searchIDBTN" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Search ID" />

</AnchorPane>
