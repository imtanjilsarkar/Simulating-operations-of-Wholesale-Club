<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"  xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Generate_Daily_Sales_Report">

    <Button layoutX="14.0" layoutY="553.0" onAction="#handleBack" prefWidth="100.0"  text="Back" />

    <Label layoutX="160.0" layoutY="40.0" style="-fx-font-size: 22px;" text="Generate Daily Sales Report" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0"  />

    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <Button onAction="#handleGenerateReport" prefWidth="250.0"  text="Generate Report" />

        <Label fx:id="transactionDataLabel" style="-fx-font-size: 16px;" text="Transactions: Not Loaded" />

        <Label fx:id="netSalesLabel" style="-fx-font-size: 16px;" text="Net Sales: Not Calculated" />

        <Label fx:id="reportStatusLabel" style="-fx-font-size: 16px;" text="Report Status: Not Generated" />

    </VBox>

</AnchorPane>
