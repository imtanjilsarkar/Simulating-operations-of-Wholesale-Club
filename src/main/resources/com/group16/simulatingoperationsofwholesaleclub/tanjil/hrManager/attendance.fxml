<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500" prefWidth="700" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.AttendanceController">

    <!-- Employee Table -->
    <TableView fx:id="employeeTable" layoutX="20" layoutY="20" prefHeight="200" prefWidth="525.0">
        <columns>
            <TableColumn fx:id="colName" prefWidth="151.20001792907715" text="Name" />
            <TableColumn fx:id="colDepartment" prefWidth="182.39996337890625" text="Department" />
            <TableColumn fx:id="colPosition" prefWidth="191.19998168945312" text="Position" />
        </columns>
    </TableView>

    <!-- Load Employees Button -->
    <Button layoutX="560.0" layoutY="20.0" onAction="#handleLoadEmployees" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Load Employees" />

    <!-- Attendance Controls -->
    <ComboBox fx:id="cmbStatus" layoutX="560.0" layoutY="68.0" prefHeight="25" prefWidth="120" />
    <Button layoutX="560.0" layoutY="280.0" onAction="#handleMarkAttendance" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Mark Attendance" />

    <!-- Attendance Table -->
    <TableView fx:id="attendanceTable" layoutX="13.0" layoutY="250.0" prefHeight="200" prefWidth="533.0">
        <columns>
            <TableColumn fx:id="colAttendanceEmployee" prefWidth="162.4000301361084" text="Employee" />
            <TableColumn fx:id="colAttendanceDate" prefWidth="174.39996337890625" text="Date" />
            <TableColumn fx:id="colAttendanceStatus" prefWidth="195.99996948242188" text="Status" />
        </columns>
    </TableView>

    <!-- Save / Clear Buttons -->
    <Button layoutX="560.0" layoutY="371.0" onAction="#handleSaveAttendance" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Save Attendance" />
    <Button layoutX="560.0" layoutY="327.0" onAction="#handleClearAttendance" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Clear Attendance" />

    <!-- Output Label -->
    <Label fx:id="outputMessage" layoutX="10.0" layoutY="468.0" prefWidth="650" style="-fx-text-fill: black;" />
   <Button layoutX="560.0" layoutY="419.0" onAction="#handleBackHRMD" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Back" />
</AnchorPane>
