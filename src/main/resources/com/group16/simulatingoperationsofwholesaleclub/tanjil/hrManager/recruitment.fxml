<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450" prefWidth="500" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.RecruitmentController">

    <!-- Title -->
    <Label layoutX="150" layoutY="20" style="-fx-font-size: 24px; -fx-text-fill: #0078D7; -fx-font-weight: bold;" text="Recruitment Form" />

    <!-- Full Name -->
    <Label layoutX="50" layoutY="80" style="-fx-text-fill: #0078D7;" text="Full Name:" />
    <TextField fx:id="txtFullName" layoutX="180" layoutY="75" prefWidth="250" promptText="Enter full name" />

    <!-- Department -->
    <Label layoutX="50" layoutY="130" style="-fx-text-fill: #0078D7;" text="Department:" />
    <ComboBox fx:id="cmbDepartment" layoutX="180" layoutY="125" prefWidth="250" promptText="Select department" />

    <!-- Position -->
    <Label layoutX="50" layoutY="180" style="-fx-text-fill: #0078D7;" text="Position:" />
    <ComboBox fx:id="cmbPosition" layoutX="180" layoutY="175" prefWidth="250" promptText="Select position" />

    <!-- Buttons -->
    <Button layoutX="13.0" layoutY="250.0" onAction="#handleAddEmployee" prefHeight="26.0" prefWidth="109.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Add Employee" />
    <Button layoutX="139.0" layoutY="250.0" onAction="#handleSaveToFile" prefHeight="26.0" prefWidth="110.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Save to File" />
    <Button layoutX="269.0" layoutY="250.0" onAction="#handleClearForm" prefHeight="26.0" prefWidth="94.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Clear Form" />

    <!-- Output message -->
    <Label fx:id="outputMessage" layoutX="50" layoutY="320" prefWidth="400" style="-fx-text-fill: red; -fx-font-size: 14px;" />
   <Button layoutX="379.0" layoutY="250.0" onAction="#handleBackHRMD" prefHeight="26.0" prefWidth="101.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;" text="Back" />
</AnchorPane>
