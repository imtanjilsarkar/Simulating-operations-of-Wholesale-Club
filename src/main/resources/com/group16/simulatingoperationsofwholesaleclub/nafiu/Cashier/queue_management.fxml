<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Queue_Management">

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="561.0" onAction="#handleBack" prefWidth="100.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Back" />

    <!-- Header -->
    <Label layoutX="160.0" layoutY="40.0" style="-fx-font-size: 22px; -fx-text-fill: #0078D7; -fx-font-weight: bold;" text="Queue Management" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" stroke="#0078D7" strokeWidth="2" />

    <!-- Content Section -->
    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <!-- Step 1: Next Customer -->
        <Button onAction="#handleNextCustomer" prefWidth="200.0" style="-fx-background-color: #005EA6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Next Customer" />

        <!-- Step 2: Log Transaction -->
        <Label fx:id="transactionLogLabel" style="-fx-text-fill: #333; -fx-font-size: 16px;" text="Transaction Log: Not Updated" />

        <!-- Step 3: Ready Status -->
        <Label fx:id="readyStatusLabel" style="-fx-text-fill: #333; -fx-font-size: 16px;" text="Ready Status: Waiting" />

    </VBox>

</AnchorPane>
