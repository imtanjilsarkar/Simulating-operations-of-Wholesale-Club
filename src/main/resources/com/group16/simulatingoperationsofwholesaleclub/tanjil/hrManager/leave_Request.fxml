<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<VBox spacing="25"
      alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.LeaveRequestController"
      style="-fx-background-color: #F4F6F9; -fx-padding: 30;">

    <!-- Title -->
    <Label text="Leave Request Management"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />

    <!-- ================= FORM CARD ================= -->
    <VBox spacing="18"
          alignment="CENTER_LEFT"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <effect>
            <DropShadow radius="20" offsetY="4"/>
        </effect>

        <Label text="Create Leave Request"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <GridPane hgap="20" vgap="15">

            <Label text="Employee Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmployeeName"
                       promptText="Enter employee name"
                       prefWidth="220"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Leave Type:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <ComboBox fx:id="cmbLeaveType"
                      prefWidth="180"
                      GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Start Date:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dpStart"
                        prefWidth="220"
                        GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="End Date:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dpEnd"
                        prefWidth="180"
                        GridPane.rowIndex="1" GridPane.columnIndex="3"/>

        </GridPane>

        <!-- Primary Actions -->
        <HBox spacing="15" alignment="CENTER">

            <!-- Primary Button -->
            <Button text="Submit Request"
                    onAction="#handleSubmitRequest"
                    style="-fx-background-color: #1976D2;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;" />

            <!-- Secondary -->
            <Button text="Load Requests"
                    onAction="#handleLoadRequests"
                    style="-fx-background-color: #E3F2FD;
                           -fx-text-fill: #1976D2;
                           -fx-background-radius: 8;" />

            <!-- Danger / Clear -->
            <Button text="Clear Table"
                    onAction="#handleClearTable"
                    style="-fx-background-color: #ECEFF1;
                           -fx-background-radius: 8;" />

        </HBox>

        <Label fx:id="outputMessage"/>

    </VBox>

    <!-- ================= LEAVE TABLE CARD ================= -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 20;">

        <effect>
            <DropShadow radius="20" offsetY="4"/>
        </effect>

        <Label text="Leave Requests"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TableView fx:id="leaveTable" prefHeight="220" prefWidth="720">
            <columns>
                <TableColumn fx:id="colEmpName" text="Employee Name" prefWidth="160"/>
                <TableColumn fx:id="colLeaveType" text="Leave Type" prefWidth="160"/>
                <TableColumn fx:id="colStartDate" text="Start Date" prefWidth="130"/>
                <TableColumn fx:id="colEndDate" text="End Date" prefWidth="130"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
            </columns>
        </TableView>

    </VBox>

    <!-- ================= STAFF CONDITION CARD ================= -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 20;">

        <effect>
            <DropShadow radius="20" offsetY="4"/>
        </effect>

        <HBox alignment="CENTER_LEFT" spacing="15">

            <Label text="Staff Condition Report"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <Button text="Load Staff Info"
                    onAction="#handleLoadStaffCondition"
                    style="-fx-background-color: #1976D2;
                           -fx-text-fill: white;
                           -fx-background-radius: 8;" />
        </HBox>

        <TableView fx:id="staffConditionTable" prefHeight="160" prefWidth="720">
            <columns>
                <TableColumn fx:id="colStaffName" text="Staff Name" prefWidth="220"/>
                <TableColumn fx:id="colDetails" text="Details" prefWidth="480"/>
            </columns>
        </TableView>

    </VBox>

    <!-- Back Button -->
    <Button text="Back"
            onAction="#handleBackHRMD"
            style="-fx-background-color: #ECEFF1;
                   -fx-background-radius: 8;" />

</VBox>