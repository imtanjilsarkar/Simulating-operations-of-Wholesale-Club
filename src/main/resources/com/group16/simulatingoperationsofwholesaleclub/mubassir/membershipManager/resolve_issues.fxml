<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.membershipManager.controller.MembershipIssuesController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: white;">

    <Label text="Membership Issues"
           layoutX="200" layoutY="20"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill:#004aad;"/>

    <Label text="Membership ID:"
           layoutX="40" layoutY="80"
           style="-fx-text-fill:#004aad;"/>
    <TextField fx:id="membershipIdTF"
               layoutX="170" layoutY="75"
               prefWidth="220"
               style="-fx-border-color:#007bff;"/>

    <Label text="Issue Description:"
           layoutX="40" layoutY="140"
           style="-fx-text-fill:#004aad;"/>
    <TextArea fx:id="issueTA"
              layoutX="170" layoutY="135"
              prefWidth="300" prefHeight="120"
              style="-fx-border-color:#007bff;"/>

    <Button text="Submit Issue"
            layoutX="170" layoutY="280"
            prefWidth="140"
            onAction="#SubmitIssueBTN"
            style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;"/>

    <Button text="Back"
            layoutX="330" layoutY="280"
            prefWidth="80"
            onAction="#BackBTN"
            style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;"/>

</AnchorPane>
