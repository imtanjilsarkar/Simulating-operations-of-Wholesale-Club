<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="700.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.RegisterMembershipRequestController">

    <!-- Title -->
    <Label layoutX="180.0" layoutY="30.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Register Membership Request" />

    <!-- Customer Name -->
    <Label layoutX="100.0" layoutY="100.0" text="Customer Name:" />
    <TextField fx:id="txtCustomerName" layoutX="250.0" layoutY="96.0" prefWidth="300.0" />

    <!-- Contact Info -->
    <Label layoutX="100.0" layoutY="150.0" text="Contact Info:" />
    <TextField fx:id="txtContactInfo" layoutX="250.0" layoutY="146.0" prefWidth="300.0" />

    <!-- Notes -->
    <Label layoutX="100.0" layoutY="200.0" text="Notes:" />
    <TextArea fx:id="txtNotes" layoutX="250.0" layoutY="196.0" prefHeight="100.0" prefWidth="300.0" />

    <!-- Submit Button -->
    <Button layoutX="250.0" layoutY="320.0" onAction="#handleSubmitRequest" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Submit" />

    <!-- Cancel Button -->
    <Button layoutX="430.0" layoutY="320.0" onAction="#handleCancel" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #0078D7; -fx-text-fill: #0078D7; -fx-background-radius: 8;" text="Cancel" />

    <!-- Message Label -->
    <Label fx:id="messageLabel" layoutX="250.0" layoutY="280.0" prefHeight="18.0" prefWidth="300.0" />

    <!-- Back Button -->
    <Button layoutX="10.0" layoutY="360.0" onAction="#handleBackCSD" prefHeight="25.0" prefWidth="60.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
