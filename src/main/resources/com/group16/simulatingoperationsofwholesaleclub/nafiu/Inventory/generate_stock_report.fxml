<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500" prefWidth="850"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Inventory.Controller.Generate_Stock_Report">

    <children>

        <!-- Title -->
        <Label text="Generate Stock Report"
               layoutX="280" layoutY="20"
               style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <!-- Generate Report Button -->
        <Button text="Generate Report"
                layoutX="60" layoutY="100"
                prefWidth="250"
                onAction="#generateReport"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;" />

        <!-- Inventory Records -->
        <Label text="Current Inventory Records:" layoutX="60" layoutY="160" />
        <TextArea fx:id="inventoryArea"
                  layoutX="60" layoutY="190"
                  prefWidth="720" prefHeight="120"
                  editable="false"
                  style="-fx-control-inner-background: #f0f0f0;" />

        <!-- Report Summary -->
        <Label text="Report Summary:" layoutX="60" layoutY="320" />
        <TextArea fx:id="summaryArea"
                  layoutX="60" layoutY="350"
                  prefWidth="720" prefHeight="100"
                  editable="false"
                  style="-fx-control-inner-background: #f0f0f0;" />

        <!-- Back Button -->
        <Button text="Back"
                layoutX="60" layoutY="470"
                prefWidth="100"
                onAction="#goBack"
                style="-fx-background-color: #777; -fx-text-fill: white;" />

    </children>

</AnchorPane>
