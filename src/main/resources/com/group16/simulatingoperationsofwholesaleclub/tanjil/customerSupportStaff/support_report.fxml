<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.SupportReportController">

    <!-- Title -->
    <Label layoutX="240.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Customer Support Report Table" />

    <!-- Table View -->
    <TableView fx:id="tblReports" layoutX="50.0" layoutY="70.0" prefHeight="350.0" prefWidth="700.0">

        <columns>
            <TableColumn fx:id="colCustomerName" prefWidth="230.0" text="Customer Name" />
            <TableColumn fx:id="colComplaintType" prefWidth="332.7999572753906" text="Complaint Title" />
            <TableColumn fx:id="colStatus" prefWidth="136.79998779296875" text="Status" />
        </columns>

    </TableView>

    <!-- Refresh Button -->
    <Button layoutX="350.0" layoutY="453.0" onAction="#handleRefresh" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Refresh" />

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="458.0" onAction="#handleBackCSD" prefHeight="17.0" prefWidth="46.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
