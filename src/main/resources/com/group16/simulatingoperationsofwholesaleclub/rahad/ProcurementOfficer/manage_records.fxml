<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.ManageSupplierRecordsController">

    <Label layoutX="180.0" layoutY="14.0"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;"
           text="Manage Supplier Records" />

    <Label layoutX="20.0" layoutY="70.0" style="-fx-font-size: 14px;" text="Supplier ID:" />
    <TextField fx:id="supplierIdField" layoutX="120.0" layoutY="65.0" prefWidth="200"
               promptText="Enter Supplier ID"/>

    <Label layoutX="20.0" layoutY="110.0" style="-fx-font-size: 14px;" text="Name:" />
    <TextField fx:id="nameField" layoutX="120.0" layoutY="105.0" prefWidth="200"
               promptText="Enter Supplier Name"/>

    <Label layoutX="20.0" layoutY="150.0" style="-fx-font-size: 14px;" text="Contact:" />
    <TextField fx:id="contactField" layoutX="120.0" layoutY="145.0" prefWidth="200"
               promptText="Phone or Email"/>

    <Label layoutX="20.0" layoutY="190.0" style="-fx-font-size: 14px;" text="Address:" />
    <TextField fx:id="addressField" layoutX="120.0" layoutY="185.0" prefWidth="300"
               promptText="Supplier Address"/>

    <Button layoutX="50.0" layoutY="250.0"
            onAction="#handleSaveButton"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;"
            text="Save" />

    <Button layoutX="200.0" layoutY="250.0"
            onAction="#handleBack"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;"
            text="Back" />

    <Label fx:id="messageLabel" layoutX="20.0" layoutY="300.0" prefWidth="560"
           style="-fx-text-fill: green;" text="" />

</AnchorPane>
