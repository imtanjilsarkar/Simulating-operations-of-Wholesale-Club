<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500" prefWidth="850" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Inventory.Controller.Generate_Stock_Report">

    <children>

        <!-- Title -->
        <Label layoutX="280" layoutY="20" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Generate Stock Report" />

        <!-- Generate Report Button -->
        <Button layoutX="60" layoutY="100" onAction="#generateReport" prefWidth="250" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Generate Report" />

        <!-- Inventory Records -->
        <Label layoutX="60" layoutY="160" text="Current Inventory Records:" />

        <!-- Report Summary -->
        <Label layoutX="60" layoutY="320" text="Report Summary:" />
        <TextArea fx:id="summaryArea" editable="false" layoutX="60" layoutY="350" prefHeight="100" prefWidth="720" style="-fx-control-inner-background: #f0f0f0;" />

        <!-- Back Button -->
        <Button layoutX="60" layoutY="470" onAction="#goBack" prefWidth="100" style="-fx-background-color: #777; -fx-text-fill: white;" text="Back" />
      <TextField fx:id="currentinventory" layoutX="57.0" layoutY="196.0" prefHeight="113.0" prefWidth="720.0" />

    </children>

</AnchorPane>
