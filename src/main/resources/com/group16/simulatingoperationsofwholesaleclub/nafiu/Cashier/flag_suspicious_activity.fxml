<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"  xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Flag_Suspicious_Activity">

    <Button layoutX="14.0" layoutY="561.0" onAction="#handleBack" prefWidth="100.0" text="Back" />

    <Label layoutX="160.0" layoutY="40.0" style="-fx-font-size: 22px;" text="Flag Suspicious Activity" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" strokeWidth="2" />

    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <VBox spacing="5.0">
            <Label style="-fx-font-size: 14px;" text="Enter Reason / Details:" />
            <TextArea fx:id="reasonField" prefHeight="100.0" prefWidth="400.0" />
            <Button onAction="#handleSubmitReport" prefWidth="150.0"  text="Submit Report" />
        </VBox>

        <Label fx:id="recordStatusLabel" style="-fx-font-size: 16px;" text="Record Status: Not Saved" />

        <Label fx:id="confirmationLabel" style="-fx-font-size: 16px;" text="Manager Confirmation: Pending" />

    </VBox>

</AnchorPane>
