<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.DeliveryCoordinator.controller.TrackDeliveryController">


    <Label layoutX="150" layoutY="40"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #004aad;"
           text="Track Delivery" />


    <Label layoutX="70" layoutY="140"
           style="-fx-font-size: 14px; -fx-text-fill: #004aad;"
           text="Order ID:" />


    <TextField fx:id="orderIdField"
               layoutX="150" layoutY="135"
               prefWidth="250"
               style="-fx-border-color: #007bff; -fx-background-radius: 5;" />


    <Label fx:id="statusLabel"
           layoutX="70" layoutY="200"
           prefWidth="470"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"
           wrapText="true"
           text="" />


    <Label fx:id="staffLabel"
           layoutX="70" layoutY="240"
           prefWidth="470"
           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #004aad;"
           wrapText="true"
           text="" />


    <Button layoutX="150" layoutY="300"
            onAction="#handleTrackDelivery"
            prefWidth="150"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8;"
            text="Track Delivery" />


    <Button layoutX="330" layoutY="300"
            onAction="#handleBack"
            prefWidth="100"
            style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 8;"
            text="Back" />

</AnchorPane>
