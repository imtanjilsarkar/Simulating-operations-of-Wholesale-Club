<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.StaffShiftController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: white;">

    <!-- Title -->
    <Label text="Assign Staff Shift"
           layoutX="210" layoutY="20"
           style="-fx-font-size: 20px; -fx-text-fill: #004aad;"/>

    <!-- Staff ID -->
    <Label text="Staff ID:"
           layoutX="80" layoutY="80"
           style="-fx-text-fill: #004aad;"/>
    <TextField fx:id="staffIdField"
               layoutX="150" layoutY="75"
               prefWidth="150"
               promptText="Enter Staff ID"/>

    <!-- Shift Date -->
    <Label text="Date:"
           layoutX="320" layoutY="80"
           style="-fx-text-fill: #004aad;"/>
    <DatePicker fx:id="shiftDatePicker"
                layoutX="360" layoutY="75"
                prefWidth="150"/>

    <!-- Shift Time -->
    <Label text="Shift Time:"
           layoutX="80" layoutY="130"
           style="-fx-text-fill: #004aad;"/>
    <TextField fx:id="shiftTimeField"
               layoutX="150" layoutY="125"
               prefWidth="150"
               promptText="e.g. 9 AM - 5 PM"/>

    <!-- Full Day Toggle -->
    <ToggleButton text="Full Day"
                  fx:id="fullDayToggle"
                  layoutX="360" layoutY="125"
                  prefWidth="150"
                  style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;"/>

    <!-- Assign Button -->
    <Button text="Assign Shift"
            fx:id="assignButton"
            layoutX="230" layoutY="180"
            prefWidth="150"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;"/>

    <!-- ✅ Back Button -->
    <Button text="Back"
            fx:id="backBtn"
            layoutX="260" layoutY="340"
            prefWidth="80"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;"/>

</AnchorPane>
