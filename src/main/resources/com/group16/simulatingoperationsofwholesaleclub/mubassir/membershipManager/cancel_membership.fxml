<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400" prefWidth="600" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.membershipManager.controller.CancelMembershipController">

    <Label alignment="CENTER" layoutX="0" layoutY="20" prefWidth="600" style="-fx-text-fill: #0d47a1;                   -fx-font-size: 22px;                   -fx-font-weight: bold;" text="Cancel Membership" />

    <TextField fx:id="membershipIdTF" layoutX="150" layoutY="80" prefHeight="26.0" prefWidth="178.0" promptText="Enter Membership ID" />

    <Button layoutX="350.0" layoutY="78.0" onAction="#searchIDBTN" prefWidth="100" style="-fx-background-color: #1976d2;                    -fx-text-fill: white;                    -fx-font-size: 14px;" text="Search ID" />

    <TextArea fx:id="infoTA" editable="false" layoutX="150.0" layoutY="138.0" prefHeight="140" prefWidth="300" wrapText="true" />

    <Label fx:id="successLabel" layoutX="69.0" layoutY="342.0" prefWidth="300" style="-fx-font-size: 14px;" />

    <Button layoutX="150.0" layoutY="305.0" onAction="#CancelMembershipBTN" prefWidth="160" style="-fx-background-color: #1976d2;                    -fx-text-fill: white;                    -fx-font-size: 14px;" text="Cancel Membership" />


    <Button layoutX="491.0" layoutY="352.0" onAction="#BackBTN" prefWidth="80" style="-fx-background-color: #1976d2;                    -fx-text-fill: white;" text="Back" />
   <Label layoutX="48.0" layoutY="84.0" text="Enter Member ID:" textFill="#4242f7" />
   <Label layoutX="118.0" layoutY="152.0" text="Info:" textFill="#4242f7" />
</AnchorPane>
