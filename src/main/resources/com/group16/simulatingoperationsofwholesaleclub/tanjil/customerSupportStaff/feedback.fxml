<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="629.0" prefWidth="698.0" spacing="30" style="-fx-background-color: #F4F6F9; -fx-padding: 40;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.FeedbackController">

    <!-- Title -->
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Customer Feedback" />

    <!-- Card Container -->
    <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30;">
        <effect>
            <DropShadow offsetY="4" radius="15" />
        </effect>

        <!-- Form Fields -->
        <VBox alignment="CENTER_LEFT" prefWidth="500" spacing="15">
            <Label text="Customer Name:" />
            <TextArea fx:id="txtCustomerName" prefHeight="35" prefWidth="400" promptText="Enter customer name" wrapText="true" />

            <Label text="Feedback:" />
            <TextArea fx:id="txtFeedback" prefHeight="150" prefWidth="400" promptText="Enter feedback..." wrapText="true" />
        </VBox>

        <!-- Message Label -->
        <Label fx:id="outputMessage" style="-fx-font-size: 14px;" textFill="#1976D2" />

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="30">
            <Button onAction="#handleSubmit" prefHeight="40" prefWidth="140" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Submit" />

            <Button onAction="#handleBackCSD" prefHeight="40" prefWidth="140" style="-fx-background-color: white; -fx-border-color: #1976D2; -fx-text-fill: #1976D2; -fx-font-weight: bold; -fx-background-radius: 8;" text="Back" />
        </HBox>
    </VBox>
</VBox>
