<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Process_Customer_Checkout">


    <Button layoutX="14.0" layoutY="561.0" onAction="#handleBack" prefWidth="100.0" text="Back" />

    <Label layoutX="160.0" layoutY="40.0" text="Process Customer Checkout" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" />

    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <VBox spacing="5.0">
            <Label text="Enter Product ID:" />
            <TextField fx:id="productIdField" prefWidth="300.0" />
            <Button onAction="#handleAddProduct" prefWidth="150.0" text="Add Product" />
        </VBox>

        <Label fx:id="totalPriceLabel" text="Total Price: 0" />

        <Button onAction="#handleMembershipCheck" prefWidth="200.0" text="Check Membership" />

    </VBox>

</AnchorPane>
