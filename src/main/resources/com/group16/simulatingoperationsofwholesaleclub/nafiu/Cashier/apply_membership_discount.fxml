<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Apply_Membership_Discount">

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="561.0" onAction="#handleBack" prefWidth="100.0" text="Back" />

    <!-- Header -->
    <Label layoutX="160.0" layoutY="40.0" text="Apply Membership Discount" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" strokeWidth="2" />

    <!-- Main Content -->
    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <!-- Step 2: Membership ID Input -->
        <VBox spacing="5.0">
            <Label text="Enter Membership ID:" />
            <TextField fx:id="membershipIdField" prefWidth="300.0" />
            <Button onAction="#handleVerifyMembership" prefWidth="120.0" text="Verify" />
        </VBox>

        <!-- Step 3: Membership Validity -->
        <Label fx:id="validityLabel" text="Membership Status: Not Checked" />

        <!-- Step 4: Recalculate Total -->
        <Button onAction="#handleRecalculateTotal" prefWidth="300.0" text="Recalculate Total With Discount" />

        <!-- Step 5: Updated Bill -->
        <Label fx:id="updatedBillLabel" text="Updated Bill: 0" />

    </VBox>

</AnchorPane>
