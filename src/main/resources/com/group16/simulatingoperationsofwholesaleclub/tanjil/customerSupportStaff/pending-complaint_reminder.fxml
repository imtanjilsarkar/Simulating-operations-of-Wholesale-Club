<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.PendingComplaintReminderController">

    <!-- Title -->
    <Label layoutX="250.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Pending Complaint Reminder" />

    <!-- Table -->
    <TableView fx:id="tblPendingComplaints" layoutX="50.0" layoutY="70.0" prefHeight="300.0" prefWidth="700.0">
        <columns>
            <TableColumn fx:id="colCustomerName" prefWidth="149.59998321533203" text="Customer Name" />
            <TableColumn fx:id="colComplaintTitle" prefWidth="304.79998779296875" text="Complaint Title" />
            <TableColumn fx:id="colStatus" prefWidth="115.19992065429688" text="Status" />
         <TableColumn fx:id="colDate" prefWidth="128.800048828125" text="Date" />
        </columns>
    </TableView>

    <!-- Load Button -->
    <Button layoutX="50.0" layoutY="390.0" onAction="#handleLoadPending" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Load Pending" />

    <!-- Back Button -->
    <Button layoutX="180.0" layoutY="390.0" onAction="#handleBackCSD" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #0078D7; -fx-text-fill: #0078D7; -fx-background-radius: 8;" text="Back" />

    <!-- Message Label -->
    <Label fx:id="messageLabel" layoutX="320.0" layoutY="400.0" prefWidth="400.0" style="-fx-text-fill: #0078D7;" />

</AnchorPane>
