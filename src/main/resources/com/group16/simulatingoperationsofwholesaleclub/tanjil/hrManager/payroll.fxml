<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450" prefWidth="600" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.PayrollController">

    <TableView fx:id="employeeTable" layoutX="20" layoutY="20" prefHeight="300" prefWidth="560">
        <columns>
            <TableColumn fx:id="colId" prefWidth="80" text="ID" />
            <TableColumn fx:id="colName" prefWidth="150" text="Name" />
            <TableColumn fx:id="colDepartment" prefWidth="120" text="Department" />
            <TableColumn fx:id="colPosition" prefWidth="120" text="Position" />
            <TableColumn fx:id="colSalary" prefWidth="90" text="Salary" />
        </columns>
    </TableView>

    <TextField fx:id="txtSalary" layoutX="20" layoutY="340" prefWidth="150" promptText="New Salary" />

    <Button layoutX="187.0" layoutY="340.0" onAction="#handleLoadEmployees" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Load Employees" />
    <Button layoutX="325.0" layoutY="340.0" onAction="#handleUpdateSalary" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Update Salary" />

    <Label fx:id="outputMessage" layoutX="20" layoutY="390" prefWidth="560" style="-fx-text-fill: black;" />
   <Button layoutX="465.0" layoutY="340.0" onAction="#handleBackHRMD" prefHeight="26.0" prefWidth="112.0" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Back" />
</AnchorPane>
