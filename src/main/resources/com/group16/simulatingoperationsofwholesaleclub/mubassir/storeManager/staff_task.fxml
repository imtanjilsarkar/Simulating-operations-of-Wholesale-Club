<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.StaffTaskController">

    <Label layoutX="230" layoutY="20" style="-fx-font-size: 20px; -fx-text-fill: #004aad;" text="Staff Task Assignment" />

    <Label layoutX="103.0" layoutY="79.0" style="-fx-text-fill: #004aad;" text="Staff ID:" />
    <TextField fx:id="staffIdTF" layoutX="150" layoutY="75" prefWidth="150" promptText="Enter Staff ID" />

    <Label layoutX="320" layoutY="80" style="-fx-text-fill: #004aad;" text="Date:" />
    <DatePicker fx:id="dateDP" layoutX="360" layoutY="75" prefWidth="150" />

    <Label layoutX="80" layoutY="130" style="-fx-text-fill: #004aad;" text="Assign Task:" />
    <ComboBox fx:id="taskComboBox" layoutX="150" layoutY="125" prefWidth="200" promptText="Select Task" />

    <Button layoutX="230" layoutY="170" onAction="#assignTaskBTN" prefWidth="150" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Assign Task" />

    <TextArea fx:id="taskOutputTA" layoutX="80" layoutY="220" prefHeight="104.0" prefWidth="440" promptText="Assigned tasks will appear here..." style="-fx-border-color: #007bff;" />

    <Button layoutX="470.0" layoutY="360.0" onAction="#backBTN" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" />
   <Label fx:id="successLabel" layoutX="80.0" layoutY="336.0" prefHeight="18.0" prefWidth="150.0" />

</AnchorPane>
