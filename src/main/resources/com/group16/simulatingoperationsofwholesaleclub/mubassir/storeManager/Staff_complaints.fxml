<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="420.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.StaffComplaintGoalController">


    <Label layoutX="20" layoutY="20" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Staff Complaint Form" />


    <Label layoutX="20" layoutY="90" style="-fx-text-fill: #004aad; -fx-font-size: 14px;" text="Staff ID/Name:" />
    <TextField fx:id="staffIdTF" layoutX="150" layoutY="85" prefWidth="250" style="-fx-border-color: #007bff; -fx-border-radius: 4; -fx-padding: 5;" />


    <Label layoutX="20" layoutY="150" style="-fx-text-fill: #004aad; -fx-font-size: 14px;" text="Complaint Details:" />
    <TextArea fx:id="complaintDetailsTF" layoutX="150" layoutY="145" prefHeight="130" prefWidth="350" style="-fx-border-color: #007bff; -fx-border-radius: 4; -fx-padding: 5;" />


    <Button layoutX="150" layoutY="300" onAction="#submitBTN" prefHeight="32" prefWidth="160" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 6;" text="Submit Complaint" />


    <Button layoutX="330" layoutY="300" onAction="#backBTN" prefHeight="32" prefWidth="100" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 6;" text="Back" />


    <Label fx:id="successLabel" layoutX="22" layoutY="350" prefWidth="300" style="-fx-text-fill: #004aad; -fx-font-size: 13px;" />

</AnchorPane>
