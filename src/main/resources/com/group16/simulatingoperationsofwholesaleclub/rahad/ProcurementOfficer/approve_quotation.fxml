<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.ApproveSupplierQuotationController">


    <Label layoutX="151.0" layoutY="14.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Approve Supplier Quotation" />


    <Label fx:id="supplierlbl" layoutX="20" layoutY="70" style="-fx-font-size: 14px;" text="Supplier:" />
    <TextField fx:id="supplierfield" layoutX="120" layoutY="65" prefWidth="200" promptText="Supplier Name" />

    <Label fx:id="productlbl" layoutX="20" layoutY="110" style="-fx-font-size: 14px;" text="Product:" />
    <TextField fx:id="productnamefield" layoutX="120" layoutY="105" prefWidth="200" promptText="Product Name" />

    <Label fx:id="messageLabel" layoutX="120" layoutY="275" style="-fx-font-size: 14px; -fx-text-fill: red;" text="" />
    <Label fx:id="pricelbl" layoutX="20" layoutY="150" style="-fx-font-size: 14px;" text="Price:" />
    <TextField fx:id="pricefield" layoutX="120" layoutY="145" prefWidth="100" promptText="Price" />


    <Label fx:id="qualitylbl" layoutX="20" layoutY="190" style="-fx-font-size: 14px;" text="Quality Notes:" />
    <TextArea fx:id="qualitynotesTA" layoutX="120" layoutY="185" prefHeight="80" prefWidth="400" promptText="Enter quality notes or comments here" />


    <Button layoutX="120" layoutY="300" onAction="#handleApproveButton" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;" text="Approve" />

    <Button layoutX="240" layoutY="300" onAction="#handleRejectButton" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;" text="Reject" />

    <Button layoutX="360" layoutY="300" onAction="#handleBack" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;" text="Back" />

</AnchorPane>
