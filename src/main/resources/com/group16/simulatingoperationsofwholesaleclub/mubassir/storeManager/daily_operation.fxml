<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.DailyOperationController">


    <Label layoutX="20" layoutY="20" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Daily Operations Overview" />


    <Label layoutX="20" layoutY="80" style="-fx-font-size: 16px; -fx-text-fill: #004aad;" text="Sales Today:" />
    <TextField fx:id="salesTF" layoutX="150" layoutY="75" prefWidth="150" promptText="0" style="-fx-border-color: #007bff;" />


    <Label layoutX="20" layoutY="130" style="-fx-font-size: 16px; -fx-text-fill: #004aad;" text="Low Stock Items:" />
    <TextField fx:id="lowStockTF" layoutX="150" layoutY="125" prefWidth="150" promptText="0" style="-fx-border-color: #007bff;" />


    <Label layoutX="20" layoutY="180" style="-fx-font-size: 16px; -fx-text-fill: #004aad;" text="Active Staff:" />
    <TextField fx:id="staffTF" layoutX="150" layoutY="175" prefWidth="150" promptText="0" style="-fx-border-color: #007bff;" />


    <Label layoutX="20" layoutY="230" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Recent Activities:" />

    <TextArea fx:id="activityTA" layoutX="20" layoutY="260" prefHeight="200" prefWidth="760" promptText="Recent activity logs will appear here..." style="-fx-border-color: #007bff;" />


    <Button layoutX="20" layoutY="480" onAction="#addActivityBTN" prefWidth="120" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Add Activity" />

    <Button layoutX="160" layoutY="480" onAction="#exportBTN" prefWidth="150" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Export Report" />

    <Button layoutX="350" layoutY="480" onAction="#backBTN" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" />

</AnchorPane>
