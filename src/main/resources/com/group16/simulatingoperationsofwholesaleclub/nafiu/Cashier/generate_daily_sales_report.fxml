<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Generate_Daily_Sales_Report">

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="553.0" onAction="#handleBack" prefWidth="100.0" style="" text="Back" />

    <!-- Header -->
    <Label layoutX="160.0" layoutY="40.0" style="-fx-font-size: 22px;" text="Generate Daily Sales Report" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" style="" />

    <!-- Content Section -->
    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <!-- Step 1: Generate Report -->
        <Button onAction="#handleGenerateReport" prefWidth="250.0" style="" text="Generate Report" />

        <!-- Step 2: Show All Transactions -->
        <Label fx:id="transactionDataLabel" style="-fx-font-size: 16px;" text="Transactions: Not Loaded" />

        <!-- Step 3: Summarize Totals -->
        <Label fx:id="netSalesLabel" style="-fx-font-size: 16px;" text="Net Sales: Not Calculated" />

        <!-- Step 4: Display Sales Report -->
        <Label fx:id="reportStatusLabel" style="-fx-font-size: 16px;" text="Report Status: Not Generated" />

    </VBox>

</AnchorPane>
