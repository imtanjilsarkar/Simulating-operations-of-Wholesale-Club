<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.SalesPerformaneController">

    <Label layoutX="220" layoutY="20" style="-fx-font-size: 20px; -fx-text-fill: #004aad;" text="Sales Performance" />


    <Button layoutX="220.0" layoutY="88.0" onAction="#viewReportBTN" prefWidth="160" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="View Sales Report" />


    <TextArea fx:id="salesOutputTA" layoutX="81.0" layoutY="142.0" prefHeight="180" prefWidth="440" promptText="Sales summary will appear here..." style="-fx-border-color: #007bff;" />

    <Button layoutX="260" layoutY="370" onAction="#backBTN" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" />

</AnchorPane>
