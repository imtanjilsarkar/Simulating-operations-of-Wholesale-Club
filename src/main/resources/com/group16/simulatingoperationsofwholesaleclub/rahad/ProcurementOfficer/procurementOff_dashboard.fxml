<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.ProcurementOfficerDashboardController">


    <Label layoutX="150.0" layoutY="25.0" style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#0078D7;" text="Procurement Officer Dashboard" />


    <Button layoutX="60.0" layoutY="90.0" onAction="#reviewRequests" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="Review Purchase Requests" />

    <Button layoutX="330.0" layoutY="90.0" onAction="#createOrder" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="Create Supplier Order" />


    <Button layoutX="60.0" layoutY="150.0" onAction="#approveQuotation" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="Approve Supplier Quotation" />

    <Button layoutX="330.0" layoutY="150.0" onAction="#resolveIssues" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="Resolve Supplier Issues" />


    <Button layoutX="60.0" layoutY="210.0" onAction="#manageRecords" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="Manage Supplier Records" />

    <Button layoutX="330.0" layoutY="210.0" onAction="#trackPendingDeliveries" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="Track Pending Supplier Deliveries" />


    <Button layoutX="60.0" layoutY="270.0" onAction="#generateReport" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="Generate Procurement Report" />

    <Button layoutX="330.0" layoutY="270.0" onAction="#contactSupplier" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="View Supplier Contact Information" />


    <Button layoutX="20.0" layoutY="355.0" onAction="#handleBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius:8;" text="Back" />

</AnchorPane>
