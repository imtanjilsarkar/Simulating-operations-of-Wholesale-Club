<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<VBox spacing="30" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.PendingComplaintReminderController"
      style="-fx-background-color: #F4F6F9; -fx-padding: 40;">

    <!-- Title -->
    <Label text="Pending Complaint Reminder"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />

    <!-- Card Container -->
    <VBox spacing="20" alignment="CENTER" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
        <effect>
            <DropShadow radius="15" offsetY="4"/>
        </effect>

        <!-- TableView -->
        <TableView fx:id="tblPendingComplaints" prefWidth="700" prefHeight="300">
            <columns>
                <TableColumn fx:id="colCustomerName" prefWidth="180" text="Customer Name"/>
                <TableColumn fx:id="colComplaintTitle" prefWidth="300" text="Complaint Title"/>
                <TableColumn fx:id="colStatus" prefWidth="120" text="Status"/>
                <TableColumn fx:id="colDate" prefWidth="100" text="Date"/>
            </columns>
        </TableView>

        <!-- Buttons -->
        <HBox spacing="30" alignment="CENTER">
            <Button text="Load Pending" onAction="#handleLoadPending"
                    style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;"
                    prefWidth="140" prefHeight="40"/>
            <Button text="Back" onAction="#handleBackCSD"
                    style="-fx-background-color: white; -fx-border-color: #1976D2; -fx-text-fill: #1976D2; -fx-font-weight: bold; -fx-background-radius: 8;"
                    prefWidth="140" prefHeight="40"/>
        </HBox>

        <!-- Message Label -->
        <Label fx:id="messageLabel" textFill="#1976D2" style="-fx-font-size: 14px;" />
    </VBox>

</VBox>