<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: #ECEFF1;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.initial.InitialController">

    <!-- Center Card Panel -->
    <VBox alignment="CENTER" layoutX="125.0" layoutY="98.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">

        <!-- Drop shadow applied directly -->
        <effect>
            <DropShadow color="#00000033" offsetX="0" offsetY="5" radius="15" />
        </effect>

        <!-- Title -->
        <Label fx:id="label" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Wholesale Club Management System" />

        <!-- Tagline -->
        <Label style="-fx-font-size: 14px; -fx-text-fill: #616161;" text="Simulating operations of Wholesale Club (HyperMarket)" />

        <!-- Decorative Line -->
        <Rectangle fill="#1976D2" height="2" width="400" />

        <!-- Buttons Container -->
        <VBox alignment="CENTER" spacing="15">

            <!-- Login Button -->
            <Button onAction="#handleLogin" prefHeight="45" prefWidth="220" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5);                            -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12;                            -fx-cursor: hand;" text="Login">
                <style>
                    .button:hover {
                    -fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);
                    }
                </style>
            </Button>

            <!-- Sign Up Button -->
            <Button onAction="#handleSignup" prefHeight="45" prefWidth="220" style="-fx-background-color: white; -fx-border-color: #1976D2; -fx-border-width: 2;                            -fx-text-fill: #1976D2; -fx-font-size: 15px; -fx-background-radius: 12;                            -fx-cursor: hand;" text="Sign Up">
                <style>
                    .button:hover {
                    -fx-background-color: #E3F2FD;
                    }
                </style>
            </Button>

        </VBox>
    </VBox>

    <!-- Footer -->
    <Label layoutX="279.0" layoutY="458.0" style="-fx-font-size: 12px; -fx-text-fill: #999999;" text="© 2026 Wholesale Club Management System" />

</AnchorPane>
