<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F9FAFB;"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Process_Customer_Checkout">

    <!-- Back Button -->
    <Button layoutX="30.0" layoutY="30.0" prefWidth="100.0" text="Back"
            onAction="#handleBack"
            style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />

    <!-- Header -->
    <Label layoutX="160.0" layoutY="40.0"
           style="-fx-font-size: 22px; -fx-text-fill: #0078D7; -fx-font-weight: bold;"
           text="Process Customer Checkout" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" stroke="#0078D7" strokeWidth="2" />

    <!-- Content Section -->
    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <!-- Step 1: Start Checkout -->
        <Button text="Start Checkout" prefWidth="300.0"
                onAction="#handleStartCheckout"
                style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />

        <!-- Step 2: Enter Product ID -->
        <VBox spacing="5.0">
            <Label text="Enter Product ID:"
                   style="-fx-text-fill: #0078D7; -fx-font-size: 14px; -fx-font-weight: bold;" />
            <TextField fx:id="productIdField" prefWidth="300.0" />
            <Button text="Add Product" prefWidth="150.0"
                    onAction="#handleAddProduct"
                    style="-fx-background-color: #005EA6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />
        </VBox>

        <!-- Step 3: System Calculates Total Price -->
        <Label fx:id="totalPriceLabel" text="Total Price: 0"
               style="-fx-text-fill: #333; -fx-font-size: 16px;" />

        <!-- Step 4: Membership Check -->
        <Button text="Check Membership" prefWidth="200.0"
                onAction="#handleMembershipCheck"
                style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" />

        <!-- Step 5: Final Bill -->
        <Label fx:id="finalBillLabel" text="Final Bill: 0"
               style="-fx-text-fill: #333; -fx-font-size: 16px;" />

    </VBox>

</AnchorPane>
