<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="680.0" prefWidth="736.0" style="-fx-background-color: #ECEFF1;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.UpdateEmployeeController">

    <!-- Center Card -->
    <VBox layoutX="60" layoutY="30" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">

        <!-- Shadow -->
        <effect>
            <DropShadow color="#00000033" offsetX="0" offsetY="5" radius="15" />
        </effect>

        <!-- Title -->
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Update Employee" />

        <!-- Search Section -->
        <GridPane hgap="15" vgap="10">
            <Label style="-fx-font-weight: bold;" text="Employee Name" />
            <TextField fx:id="txtSearchName" prefWidth="220" promptText="Enter employee name" style="-fx-background-radius: 8; -fx-border-radius: 8;" GridPane.columnIndex="1" />

            <Button onAction="#handleSearch" prefHeight="35" prefWidth="120" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5);                            -fx-text-fill: white; -fx-font-weight: bold;                            -fx-background-radius: 8; -fx-cursor: hand;" text="Search" GridPane.columnIndex="2" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Update Form -->
        <GridPane hgap="15" vgap="15">

            <Label style="-fx-font-weight: bold;" text="Department" />
            <ComboBox fx:id="cmbDepartment" prefWidth="220" style="-fx-background-radius: 8;" GridPane.columnIndex="1" />

            <Label style="-fx-font-weight: bold;" text="Position" GridPane.rowIndex="1" />
            <ComboBox fx:id="cmbPosition" prefWidth="220" style="-fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Action Buttons -->
        <GridPane hgap="15" vgap="15">

            <Button onAction="#handleUpdate" prefHeight="38" prefWidth="130" style="-fx-background-color: #1976D2; -fx-text-fill: white;                            -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Update" />

            <Button onAction="#handleClearForm" prefHeight="38" prefWidth="130" style="-fx-background-color: #ECEFF1; -fx-text-fill: #1976D2;                            -fx-border-color: #1976D2; -fx-border-radius: 10;                            -fx-background-radius: 10; -fx-cursor: hand;" text="Clear" GridPane.columnIndex="1" />

            <Button onAction="#handleLoadEmployees" prefHeight="38" prefWidth="150" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5);                            -fx-text-fill: white; -fx-font-weight: bold;                            -fx-background-radius: 10; -fx-cursor: hand;" text="Load Employees" GridPane.columnIndex="2" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Output Message -->
        <Label fx:id="outputMessage" prefWidth="550" style="-fx-font-size: 14px;" />

        <!-- Table -->
        <TableView fx:id="employeeTable" prefHeight="220" prefWidth="580" style="-fx-background-radius: 10;">

            <columns>
                <TableColumn fx:id="colId" prefWidth="90" text="ID" />
                <TableColumn fx:id="colName" prefWidth="160" text="Name" />
                <TableColumn fx:id="colDepartment" prefWidth="160" text="Department" />
                <TableColumn fx:id="colPosition" prefWidth="160" text="Position" />
            </columns>

        </TableView>

        <!-- Back Button -->
        <Button onAction="#handleBackHRMD" prefHeight="40" prefWidth="580" style="-fx-background-color: #455A64; -fx-text-fill: white;                        -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Back" />

    </VBox>

</AnchorPane>
