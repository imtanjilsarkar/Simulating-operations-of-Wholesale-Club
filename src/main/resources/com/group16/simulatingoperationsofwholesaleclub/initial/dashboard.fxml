<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #ECEFF1;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.initial.DashboardController">

    <!-- Center Card Panel -->
    <VBox alignment="TOP_CENTER" layoutX="240.0" layoutY="22.0" prefHeight="543.0" prefWidth="451.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;">

        <!-- Drop Shadow -->
        <effect>
            <DropShadow color="#00000033" offsetX="0" offsetY="5" radius="15" />
        </effect>

        <!-- Title -->
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Select Your Role to Continue" />

        <!-- Subtitle -->
        <Label style="-fx-font-size: 14px; -fx-text-fill: #616161;" text="Choose your position to access the system" />

        <!-- Grid of Role Buttons -->
        <GridPane hgap="30" vgap="20">
            <!-- Row 1 -->
            <Button onAction="#handleCashier" prefHeight="60" prefWidth="180" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="Cashier">
                <style>
                    .button:hover {-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);}
                </style>
            </Button>
            <Button onAction="#handleInventoryManager" prefHeight="60" prefWidth="180" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="Inventory Manager" GridPane.columnIndex="1">
                <style>
                    .button:hover {-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);}
                </style>
            </Button>

            <!-- Row 2 -->
            <Button onAction="#handleStoreManager" prefHeight="60" prefWidth="180" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="Store Manager" GridPane.rowIndex="1">
                <style>
                    .button:hover {-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);}
                </style>
            </Button>
            <Button onAction="#handleMembershipManager" prefHeight="60" prefWidth="180" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="Membership Manager" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <style>
                    .button:hover {-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);}
                </style>
            </Button>

            <!-- Row 3 -->
            <Button onAction="#handleDeliveryCoordinator" prefHeight="60" prefWidth="180" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="Delivery Coordinator" GridPane.rowIndex="2">
                <style>
                    .button:hover {-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);}
                </style>
            </Button>
            <Button onAction="#handleProcurementOfficer" prefHeight="60" prefWidth="180" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="Procurement Officer" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <style>
                    .button:hover {-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);}
                </style>
            </Button>

            <!-- Row 4 -->
            <Button onAction="#handleHRManager" prefHeight="60" prefWidth="180" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="HR Manager" GridPane.rowIndex="3">
                <style>
                    .button:hover {-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);}
                </style>
            </Button>
            <Button onAction="#handleCustomerSupport" prefHeight="60" prefWidth="180" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5); -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="Customer Support Staff" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <style>
                    .button:hover {-fx-background-color: linear-gradient(to bottom, #1E88E5, #1565C0);}
                </style>
            </Button>
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>

        <!-- Logout Button -->
        <Button onAction="#logOutButton" prefHeight="35" prefWidth="120" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-cursor: hand;" text="Log Out">
            <style>
                .button:hover {-fx-background-color: #1565C0;}
            </style>
        </Button>

    </VBox>

    <!-- Footer -->
    <Label layoutX="345.0" layoutY="577.0" style="-fx-font-size: 12px; -fx-text-fill: #999999;" text="© 2026 Wholesale Club Management System" />

</AnchorPane>
