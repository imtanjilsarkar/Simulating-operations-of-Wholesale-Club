<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="418.0" prefWidth="644.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.ViewSupplierContactsController">


    <Label layoutX="153.0" layoutY="14.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Supplier Contact Information" />


    <Button layoutX="20.0" layoutY="54.0" onAction="#loadContacts" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8;" text="Load Contacts" />


    <TableView fx:id="supplierTable" layoutX="13.0" layoutY="111.0" prefHeight="191.0" prefWidth="618.0">

        <columns>
            <TableColumn fx:id="suppID" prefWidth="120.0000057220459" text="Supplier ID" />
            <TableColumn fx:id="suppName" prefWidth="280.79998779296875" text="Supplier Name" />
         <TableColumn fx:id="suppPhone" prefWidth="122.39999389648438" text="Phone" />
         <TableColumn fx:id="suppaddress" prefWidth="90.4000244140625" text="Address" />
        </columns>
    </TableView>


    <Button layoutX="20.0" layoutY="360.0" onAction="#handleBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
