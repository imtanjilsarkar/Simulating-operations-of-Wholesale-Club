<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.RemoveEmployeeController">

    <!-- Header -->
    <Label layoutX="354.0" layoutY="38.0" style="-fx-font-size: 22px; -fx-text-fill: #0078D7; -fx-font-weight: bold;" text="Remove Employee" />

    <!-- Divider Line -->
    <Label layoutX="150.0" layoutY="80.0" style="-fx-border-color: #0078D7; -fx-border-width: 0 0 2 0; -fx-pref-width: 600;" text="" />

    <!-- Search Field -->
    <Label layoutX="160.0" layoutY="118.0" style="-fx-text-fill: #333333; -fx-font-size: 14px;" text="Search by Name:" />
    <TextField fx:id="txtSearch" layoutX="368.0" layoutY="115.0" prefWidth="300.0" promptText="Enter employee name" />
    <Button layoutX="678.0" layoutY="115.0" onAction="#handleSearch" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Search" />

    <!-- Load Employees Button -->
    <Button layoutX="150.0" layoutY="140.0" onAction="#handleLoadEmployees" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Load Employees" />

    <!-- Employee Table -->
    <TableView fx:id="employeeTable" layoutX="150.0" layoutY="180.0" prefHeight="320.0" prefWidth="620.0">
        <columns>
            <TableColumn fx:id="colName" prefWidth="200" text="Full Name" />
            <TableColumn fx:id="colDepartment" prefWidth="200" text="Department" />
            <TableColumn fx:id="colPosition" prefWidth="200" text="Position" />
        </columns>
    </TableView>

    <!-- Remove Button -->
    <Button layoutX="380.0" layoutY="520.0" onAction="#handleRemoveEmployee" prefWidth="140" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Remove Selected" />

    <!-- Output Message -->
    <Label fx:id="outputMessage" layoutX="150.0" layoutY="510.0" style="-fx-text-fill: green; -fx-font-size: 14px;" />

    <!-- Back Button -->
    <Button layoutX="26.0" layoutY="519.0" onAction="#handleBackHRMD" prefHeight="31.0" prefWidth="54.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
