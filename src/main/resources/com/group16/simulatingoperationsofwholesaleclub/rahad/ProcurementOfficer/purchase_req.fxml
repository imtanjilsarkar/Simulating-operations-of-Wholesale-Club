<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.ReviewPurchaseRequestController">


    <Label layoutX="146.0" layoutY="14.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Review Purchase Requests" />


    <TableView layoutX="20" layoutY="60" prefHeight="220" prefWidth="560">
        <columns>
            <TableColumn prefWidth="168.0" text="Request ID" />
            <TableColumn prefWidth="196.79998779296875" text="Product" />
            <TableColumn prefWidth="195.2000732421875" text="Quantity" />
        </columns>
    </TableView>

    <Button layoutX="30.0" layoutY="330.0" onAction="#handleApproveButton" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;" text="Approve" />

    <Button layoutX="158.0" layoutY="330.0" onAction="#handleRejectButton" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;" text="Reject" />

    <Button layoutX="300.0" layoutY="330.0" onAction="#handleBackButton" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 100px;" text="Back" />


    <Label layoutX="20.0" layoutY="291.0" prefWidth="560" style="-fx-text-fill: green;" text="" />

</AnchorPane>
