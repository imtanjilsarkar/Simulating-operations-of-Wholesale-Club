<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="646.0" prefWidth="801.0" spacing="30" style="-fx-background-color: #F4F6F9; -fx-padding: 40;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.RegisterMembershipRequestController">

    <!-- Title -->
    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Register Membership Request" />

    <!-- Card Container -->
    <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30;">
        <effect>
            <DropShadow offsetY="4" radius="15" />
        </effect>

        <!-- Form Fields -->
        <VBox alignment="CENTER_LEFT" prefWidth="600" spacing="15">
            <Label text="Customer Name:" />
            <TextField fx:id="txtCustomerName" prefWidth="400" promptText="Enter Customer Name" />

            <Label text="Contact Info:" />
            <TextField fx:id="txtContactInfo" prefWidth="400" promptText="Enter Contact Info" />

            <Label text="Notes:" />
            <TextArea fx:id="txtNotes" prefHeight="100" prefWidth="400" promptText="Additional notes..." />
        </VBox>

        <!-- Message Label -->
        <Label fx:id="messageLabel" style="-fx-font-size: 14px;" textFill="#1976D2" />

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="30">
            <Button onAction="#handleSubmitRequest" prefHeight="40" prefWidth="140" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Submit" />

            <Button onAction="#handleCancel" prefHeight="40" prefWidth="140" style="-fx-background-color: white; -fx-border-color: #1976D2; -fx-text-fill: #1976D2; -fx-font-weight: bold; -fx-background-radius: 8;" text="Cancel" />
        </HBox>

        <!-- Back Button -->
        <Button onAction="#handleBackCSD" prefHeight="35" prefWidth="100" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Back" />
    </VBox>

</VBox>
