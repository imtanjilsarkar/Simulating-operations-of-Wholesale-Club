<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.deliveryCoordinator.controller.TrackDeliveryController">

    <!-- Title -->
    <Label layoutX="200.0" layoutY="40.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Track Delivery" />

    <!-- Delivery ID Search -->
    <Label layoutX="54.0" layoutY="96.0" text="Delivery ID:" />
    <TextField fx:id="deliveryIdTF" layoutX="150.0" layoutY="92.0" prefWidth="200.0" />
    <Button layoutX="408.0" layoutY="92.0" onAction="#TrackDeliveryBTN" prefWidth="80.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Track" />

    <!-- Tracking Table -->
    <TableView fx:id="deliveryTable" layoutX="16.0" layoutY="129.0" prefHeight="210.0" prefWidth="572.0" style="-fx-border-color: #BDBDBD; -fx-background-radius: 6; -fx-border-radius: 6;">

        <columns>
            <TableColumn fx:id="colOrderID" prefWidth="150" text="Order ID" />
            <TableColumn fx:id="colDriverName" prefWidth="150" text="Driver Name" />
            <TableColumn fx:id="colLocation" prefWidth="150" text="Current Location" />
            <TableColumn fx:id="colETA" prefWidth="150" text="ETA" />
        </columns>

    </TableView>

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="360.0" onAction="#handleBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Back" />


</AnchorPane>
