<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.membershipManager.controller.NewMembershipController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: white;">

    <Label text="New Membership Registration"
           layoutX="160" layoutY="20"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill:#004aad;"/>

    <Label text="Customer Name:"
           layoutX="40" layoutY="80"
           style="-fx-text-fill:#004aad;"/>
    <TextField fx:id="customerNameTF"
               layoutX="170" layoutY="75"
               prefWidth="200"
               style="-fx-border-color:#007bff;"/>

    <Label text="Phone Number:"
           layoutX="40" layoutY="130"
           style="-fx-text-fill:#004aad;"/>
    <TextField fx:id="phoneTF"
               layoutX="170" layoutY="125"
               prefWidth="200"
               style="-fx-border-color:#007bff;"/>

    <Label text="Membership Type:"
           layoutX="40" layoutY="180"
           style="-fx-text-fill:#004aad;"/>
    <ComboBox fx:id="membershipTypeCB"
              layoutX="170" layoutY="175"
              prefWidth="200"
              style="-fx-border-color:#007bff;"/>

    <Label text="Start Date:"
           layoutX="40" layoutY="230"
           style="-fx-text-fill:#004aad;"/>
    <DatePicker fx:id="startDP"
                layoutX="170" layoutY="225"
                prefWidth="200"
                style="-fx-border-color:#007bff;"/>

    <Button text="Register"
            layoutX="170" layoutY="290"
            prefWidth="120"
            onAction="#RegisterBTN"
            style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;"/>

    <Button text="Back"
            layoutX="310" layoutY="290"
            prefWidth="80"
            onAction="#BackBTN"
            style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;"/>

</AnchorPane>
