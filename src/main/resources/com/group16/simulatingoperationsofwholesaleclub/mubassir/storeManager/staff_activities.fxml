<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.StaffActivitiesController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: white;">

    <!-- Title -->
    <Label text="Staff Activity Audit"
           layoutX="210" layoutY="20"
           style="-fx-font-size: 20px; -fx-text-fill: #004aad;"/>

    <!-- Staff ID -->
    <Label text="Staff ID:"
           layoutX="80" layoutY="80"
           style="-fx-text-fill: #004aad;"/>
    <TextField fx:id="staffIdField"
               layoutX="150" layoutY="75"
               prefWidth="150"
               promptText="Enter Staff ID"/>

    <!-- Date -->
    <Label text="Date:"
           layoutX="320" layoutY="80"
           style="-fx-text-fill: #004aad;"/>
    <DatePicker fx:id="datePicker"
                layoutX="360" layoutY="75"
                prefWidth="150"/>

    <!-- View Activity Button -->
    <Button text="View Activities"
            fx:id="viewButton"
            layoutX="230" layoutY="130"
            prefWidth="150"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;"/>

    <!-- Results Area -->
    <TextArea fx:id="activityOutputArea"
              layoutX="80" layoutY="180"
              prefWidth="440" prefHeight="180"
              promptText="Activity details will appear here..."
              style="-fx-border-color: #007bff;"/>

    <!-- ✅ Back Button -->
    <Button text="Back"
            fx:id="backBtn"
            layoutX="260" layoutY="370"
            prefWidth="80"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;"/>

</AnchorPane>
