<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400" prefWidth="600" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Inventory.Controller.Monitor_Stock_Level">

    <VBox layoutX="50" layoutY="40" spacing="15">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Monitor Stock Levels" />

        <Label text="Product Name:" />
        <TextField fx:id="productNameField" promptText="Enter product name" />

        <Label text="Available Quantity:" />
        <TextField fx:id="quantityField" editable="false" promptText="Quantity will appear here" />

        <Button fx:id="checkButton" onAction="#handleInventory" prefWidth="150" text="Check Inventory" />
        <Button fx:id="backButton" onAction="#handleBack" prefWidth="150" text="Back" />

    </VBox>

</AnchorPane>
