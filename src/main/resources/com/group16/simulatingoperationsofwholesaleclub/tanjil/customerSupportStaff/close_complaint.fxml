<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.SupportReportController">

    <!-- Title -->
    <Label layoutX="280.0" layoutY="40.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Pending Complaints" />

    <!-- TableView -->
    <TableView fx:id="tblReports" layoutX="100.0" layoutY="100.0" prefWidth="600.0" prefHeight="300.0">
        <columns>
            <TableColumn fx:id="colCustomerName" text="Customer Name" prefWidth="300.0"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="300.0"/>
        </columns>
    </TableView>

    <!-- Load Button -->
    <Button layoutX="300.0" layoutY="420.0" prefWidth="200.0" prefHeight="40.0"
            style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;"
            text="Load Pending Complaints" onAction="#handleLoadComplaints"/>

    <!-- Message Label -->
    <Label fx:id="messageLabel" layoutX="200.0" layoutY="470.0" prefWidth="400.0" style="-fx-text-fill: #0078D7; -fx-font-weight: bold;"/>
</AnchorPane>
