<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="628.0" prefWidth="805.0" style="-fx-background-color: #ECEFF1;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.LeaveApprovalController">

    <!-- Center Card -->
    <VBox layoutX="60" layoutY="30" spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;">

        <!-- Shadow -->
        <effect>
            <DropShadow color="#00000033" offsetX="0" offsetY="5" radius="15" />
        </effect>

        <!-- Title -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="Leave Approval Management" />

        <!-- Table -->
        <TableView fx:id="leaveTable" prefHeight="350" prefWidth="660" style="-fx-background-radius: 10;">

            <columns>
                <TableColumn fx:id="colEmpName" prefWidth="150" text="Employee Name" />
                <TableColumn fx:id="colLeaveType" prefWidth="130" text="Leave Type" />
                <TableColumn fx:id="colStartDate" prefWidth="120" text="Start Date" />
                <TableColumn fx:id="colEndDate" prefWidth="120" text="End Date" />
                <TableColumn fx:id="colStatus" prefWidth="140" text="Status" />
            </columns>

        </TableView>

        <!-- Buttons -->
        <HBox spacing="15">

            <Button onAction="#handleLoadRequests" prefHeight="40" prefWidth="140" style="-fx-background-color: linear-gradient(to bottom, #42A5F5, #1E88E5);                            -fx-text-fill: white; -fx-font-weight: bold;                            -fx-background-radius: 10; -fx-cursor: hand;" text="Load Requests" />

            <Button onAction="#handleApprove" prefHeight="40" prefWidth="140" style="-fx-background-color: #2E7D32; -fx-text-fill: white;                            -fx-font-weight: bold; -fx-background-radius: 10;                            -fx-cursor: hand;" text="Approve" />

            <Button onAction="#handleReject" prefHeight="40" prefWidth="140" style="-fx-background-color: #D32F2F; -fx-text-fill: white;                            -fx-font-weight: bold; -fx-background-radius: 10;                            -fx-cursor: hand;" text="Reject" />

            <Button onAction="#handleBackHRMD" prefHeight="40" prefWidth="140" style="-fx-background-color: #455A64; -fx-text-fill: white;                            -fx-font-weight: bold; -fx-background-radius: 10;                            -fx-cursor: hand;" text="Back" />

        </HBox>

        <!-- Output -->
        <Label fx:id="outputMessage" prefWidth="650" style="-fx-font-size: 14px;" />

    </VBox>

</AnchorPane>
