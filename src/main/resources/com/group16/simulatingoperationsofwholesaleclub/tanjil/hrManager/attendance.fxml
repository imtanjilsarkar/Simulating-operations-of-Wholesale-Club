<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<VBox spacing="25"
      alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.AttendanceController"
      style="-fx-background-color: #F4F6F9; -fx-padding: 30;">

    <!-- Title -->
    <Label text="Attendance Management"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" />

    <!-- ================= EMPLOYEE CARD ================= -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 20;">

        <effect>
            <DropShadow radius="20" offsetY="4"/>
        </effect>

        <HBox alignment="CENTER_LEFT" spacing="20">

            <Label text="Employee List"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Load Employees"
                    onAction="#handleLoadEmployees"
                    style="-fx-background-color: #E3F2FD;
                           -fx-text-fill: #1976D2;
                           -fx-background-radius: 8;" />
        </HBox>

        <TableView fx:id="employeeTable" prefHeight="200" prefWidth="720">
            <columns>
                <TableColumn fx:id="colName" text="Name" prefWidth="200"/>
                <TableColumn fx:id="colDepartment" text="Department" prefWidth="240"/>
                <TableColumn fx:id="colPosition" text="Position" prefWidth="240"/>
            </columns>
        </TableView>

    </VBox>

    <!-- ================= ATTENDANCE ACTION CARD ================= -->
    <VBox spacing="20"
          alignment="CENTER"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <effect>
            <DropShadow radius="20" offsetY="4"/>
        </effect>

        <Label text="Mark Attendance"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <HBox spacing="15" alignment="CENTER">
            <Label text="Status:"/>
            <ComboBox fx:id="cmbStatus" prefWidth="180"/>
            <Button text="Mark Attendance"
                    onAction="#handleMarkAttendance"
                    style="-fx-background-color: #1976D2;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;" />
        </HBox>

    </VBox>

    <!-- ================= ATTENDANCE RECORD CARD ================= -->
    <VBox spacing="15"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-padding: 20;">

        <effect>
            <DropShadow radius="20" offsetY="4"/>
        </effect>

        <Label text="Attendance Records"
               style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TableView fx:id="attendanceTable" prefHeight="200" prefWidth="720">
            <columns>
                <TableColumn fx:id="colAttendanceEmployee" text="Employee" prefWidth="240"/>
                <TableColumn fx:id="colAttendanceDate" text="Date" prefWidth="240"/>
                <TableColumn fx:id="colAttendanceStatus" text="Status" prefWidth="240"/>
            </columns>
        </TableView>

        <HBox spacing="15" alignment="CENTER">
            <Button text="Save Attendance"
                    onAction="#handleSaveAttendance"
                    style="-fx-background-color: #1976D2;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;" />

            <Button text="Clear Attendance"
                    onAction="#handleClearAttendance"
                    style="-fx-background-color: #ECEFF1;
                           -fx-background-radius: 8;" />
        </HBox>

    </VBox>

    <!-- Output -->
    <Label fx:id="outputMessage"/>

    <!-- Back -->
    <Button text="Back"
            onAction="#handleBackHRMD"
            style="-fx-background-color: #ECEFF1;
                   -fx-background-radius: 8;" />

</VBox>