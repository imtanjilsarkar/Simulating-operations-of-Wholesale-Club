<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.RecruitmentController"
            prefWidth="500" prefHeight="450"
            style="-fx-background-color: white;">

    <!-- Title -->
    <Label text="Recruitment Form"
           layoutX="150" layoutY="20"
           style="-fx-font-size: 24px; -fx-text-fill: #0078D7; -fx-font-weight: bold;"/>

    <!-- Full Name -->
    <Label text="Full Name:" layoutX="50" layoutY="80" style="-fx-text-fill: #0078D7;"/>
    <TextField fx:id="txtFullName" layoutX="180" layoutY="75" prefWidth="250" promptText="Enter full name"/>

    <!-- Department -->
    <Label text="Department:" layoutX="50" layoutY="130" style="-fx-text-fill: #0078D7;"/>
    <ComboBox fx:id="cmbDepartment" layoutX="180" layoutY="125" prefWidth="250" promptText="Select department"/>

    <!-- Position -->
    <Label text="Position:" layoutX="50" layoutY="180" style="-fx-text-fill: #0078D7;"/>
    <ComboBox fx:id="cmbPosition" layoutX="180" layoutY="175" prefWidth="250" promptText="Select position"/>

    <!-- Buttons -->
    <Button text="Add Employee" layoutX="50" layoutY="250" prefWidth="120"
            style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;"
            onAction="#handleAddEmployee"/>
    <Button text="Save to File" layoutX="190" layoutY="250" prefWidth="120"
            style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;"
            onAction="#handleSaveToFile"/>
    <Button text="Clear Form" layoutX="330" layoutY="250" prefWidth="120"
            style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;"
            onAction="#handleClearForm"/>

    <!-- Output message -->
    <Label fx:id="outputMessage" layoutX="50" layoutY="320" prefWidth="400"
           style="-fx-text-fill: red; -fx-font-size: 14px;"/>
</AnchorPane>
