<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500" prefWidth="600" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.UpdateEmployeeController">

    <!-- Search Employee -->
    <Label layoutX="50" layoutY="20" text="Employee Name:" />
    <TextField fx:id="txtSearchName" layoutX="180" layoutY="15" prefWidth="200" />
    <Button layoutX="400" layoutY="15" onAction="#handleSearch" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Search" />

    <!-- Department -->
    <Label layoutX="50" layoutY="70" text="Department:" />
    <ComboBox fx:id="cmbDepartment" layoutX="180" layoutY="65" prefWidth="200" />

    <!-- Position -->
    <Label layoutX="50" layoutY="120" text="Position:" />
    <ComboBox fx:id="cmbPosition" layoutX="180" layoutY="115" prefWidth="200" />

    <!-- Buttons -->
    <Button layoutX="120.0" layoutY="170.0" onAction="#handleUpdate" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Update" />
    <Button layoutX="253.0" layoutY="170.0" onAction="#handleClearForm" prefHeight="30" prefWidth="120" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Clear" />
    <Button layoutX="389.0" layoutY="170.0" onAction="#handleLoadEmployees" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Load Employees" />


    <!-- Output Label -->
    <Label fx:id="outputMessage" layoutX="50" layoutY="220" prefWidth="500" style="-fx-text-fill: black;" />

    <!-- TableView -->
    <TableView fx:id="employeeTable" layoutX="44.0" layoutY="250.0" prefHeight="200" prefWidth="500">
        <columns>
            <TableColumn fx:id="colId" prefWidth="80" text="ID" />
            <TableColumn fx:id="colName" prefWidth="150" text="Name" />
            <TableColumn fx:id="colDepartment" prefWidth="140" text="Department" />
            <TableColumn fx:id="colPosition" prefWidth="130" text="Position" />
        </columns>
    </TableView>
   <Button layoutX="6.0" layoutY="464.0" onAction="#handleBackHRMD" prefHeight="26.0" prefWidth="83.0" style="-fx-background-color: #0078D7; -fx-text-fill: white;" text="Back" />

</AnchorPane>
