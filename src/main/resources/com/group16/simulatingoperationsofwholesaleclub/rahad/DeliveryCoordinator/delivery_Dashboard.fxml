<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.deliveryCoordinator.controller.deliveryCoordinatorDashboardController">


    <Label layoutX="140.0" layoutY="25.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Delivery Coordinator Dashboard" />


    <Button layoutX="60.0" layoutY="90.0" onAction="#handleAssignTasks" prefHeight="40" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Assign Delivery Tasks" />


    <Button layoutX="330.0" layoutY="90.0" onAction="#handleTrackDelivery" prefHeight="40" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Track Delivery" />


    <Button layoutX="60.0" layoutY="150.0" onAction="#handleConfirmDelivery" prefHeight="40" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Confirm Delivery" />


    <Button layoutX="330.0" layoutY="150.0" onAction="#handleReportProblems" prefHeight="40" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Report Delivery Problems" />


    <Button layoutX="60.0" layoutY="210.0" onAction="#handleDeliverySchedule" prefHeight="40" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Delivery Schedule" />


    <Button layoutX="330.0" layoutY="210.0" onAction="#handleDeliveryReport" prefHeight="40" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Generate Delivery Report" />


    <Button layoutX="60.0" layoutY="270.0" onAction="#handleReturnedOrders" prefHeight="40" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Returned Orders" />


    <Button layoutX="330.0" layoutY="270.0" onAction="#handleRequestReDelivery" prefHeight="40" prefWidth="200.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Request Re-Delivery" />

    <Button layoutX="20.0" layoutY="355.0" onAction="#handleBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color:#0078D7; -fx-text-fill:white; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
