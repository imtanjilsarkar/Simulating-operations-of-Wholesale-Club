<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="375.0" prefWidth="575.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.DeliveryCoordinator.controller.AssignDeliveryTasksController">

    <!-- Headline -->
    <Label layoutX="140.0" layoutY="10.0" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#004aad;" text="Assign Delivery Task" />

    <!-- Staff ID -->
    <Label layoutX="52.0" layoutY="69.0" style="-fx-text-fill:#004aad;" text="Staff ID:" />
    <TextField fx:id="staffIdField" layoutX="130.0" layoutY="64.0" prefWidth="200.0" style="-fx-border-color:#007bff;" />

    <!-- Delivery Number -->
    <Label layoutX="49.0" layoutY="122.0" style="-fx-text-fill:#004aad;" text="Order ID" />
    <TextField fx:id="deliveryNoField" layoutX="130.0" layoutY="117.0" prefWidth="200.0" style="-fx-border-color:#007bff;" />

    <!-- Delivery Date -->
    <Label layoutX="25.0" layoutY="171.0" style="-fx-text-fill:#004aad;" text="Delivery Date:" />
    <DatePicker fx:id="deliveryDatePicker" layoutX="130.0" layoutY="166.0" prefWidth="200.0" style="-fx-border-color:#007bff;" />

    <!-- Assign Delivery Button -->
    <Button layoutX="140.0" layoutY="253.0" onAction="#AssignDeliveryBTN" prefWidth="120" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Assign Delivery" />

    <!-- Success / Error Message Label -->
    <Label fx:id="successLabel" layoutX="20.0" layoutY="210.0" prefWidth="450.0" style="-fx-text-fill: green; -fx-font-weight: bold;" text="" wrapText="true" />

    <!-- Back Button -->
    <Button layoutX="470.0" layoutY="318.0" onAction="#handleBack" prefWidth="80" style="-fx-background-color:#6c757d; -fx-text-fill:white; -fx-background-radius:5;" text="Back" />

</AnchorPane>
