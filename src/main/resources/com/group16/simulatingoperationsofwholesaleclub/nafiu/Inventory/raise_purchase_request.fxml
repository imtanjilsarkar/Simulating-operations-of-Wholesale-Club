<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Inventory.Controller.Raise_Purchase_Request">

    <Button layoutX="14.0" layoutY="561.0" onAction="#handleBack" prefWidth="100.0" style="-fx-font-weight: bold; -fx-background-radius: 6;" text="Back" />

    <Label layoutX="160.0" layoutY="40.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Raise Purchase Request" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" strokeWidth="2" />

    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <VBox spacing="5.0">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Enter Product ID:" />
            <TextField fx:id="productIdField" prefWidth="300.0" />
        </VBox>

        <VBox spacing="5.0">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Required Quantity:" />
            <TextField fx:id="quantityField" prefWidth="300.0" />
        </VBox>

        <Label fx:id="validationMessage" style="-fx-font-size: 14px;" />

        <Button onAction="#handleSubmitRequest" prefWidth="250.0" style="-fx-font-weight: bold; -fx-background-radius: 6;" text="Submit Request" />

        <Label fx:id="confirmationMessage" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    </VBox>

</AnchorPane>
