<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.mubassir.storeManager.controller.ApprovePurchaseController">

    <Label layoutX="210" layoutY="20" style="-fx-font-size: 20px; -fx-text-fill: #004aad;" text="Approve Purchase Request" />

    <Label layoutX="80" layoutY="80" style="-fx-text-fill: #004aad;" text="Request ID:" />
    <TextField fx:id="requestIdTF" layoutX="170" layoutY="75" prefWidth="200" promptText="Enter Request ID" />

    <Label layoutX="80" layoutY="130" style="-fx-text-fill: #004aad;" text="Details:" />
    <TextArea fx:id="requestDetailsTF" layoutX="170" layoutY="125" prefHeight="100" prefWidth="300" promptText="Enter request details" />


    <Button fx:id="approveBTN" layoutX="80" layoutY="250" onAction="#approveRequest" prefWidth="120" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Approve" />


    <Button fx:id="rejectBTN" layoutX="220" layoutY="250" onAction="#rejectRequest" prefWidth="120" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Reject" />


    <Button fx:id="backBTN" layoutX="360" layoutY="250" onAction="#backBTN" prefWidth="100" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" />


    <Label fx:id="messageLabel" layoutX="80" layoutY="310" style="-fx-text-fill: green; -fx-font-size: 14px;" text="" />

</AnchorPane>
