<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.ProcurementOfficer.controller.GenerateProcurementReportController">


    <!-- Title -->
    <Label layoutX="165.0" layoutY="20.0" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;" text="Generate Procurement Report" />


    <!-- Generate Report Button -->
    <Button layoutX="25.0" layoutY="279.0" onAction="#generateReport" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Generate Report" />


    <!-- Report Summary Output -->
    <TextArea fx:id="reportArea" editable="false" layoutX="42.0" layoutY="82.0" prefHeight="180.0" prefWidth="500.0" promptText="Report summary will appear here..." style="-fx-border-color:#007bff; -fx-border-radius: 5;" />


    <!-- Download Button -->
    <Button layoutX="207.0" layoutY="281.0" onAction="#downloadReport" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Download" />


    <!-- Back Button -->
    <Button layoutX="20.0" layoutY="355.0" onAction="#handleBack" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius: 8;" text="Back" />

</AnchorPane>
