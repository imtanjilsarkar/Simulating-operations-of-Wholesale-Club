<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.hrManager.controller.HRReportController">

    <Label text="HR Report" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TableView fx:id="employeeTable" prefHeight="400" prefWidth="700">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="120"/>
            <TableColumn fx:id="colName" text="Name" prefWidth="150"/>
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="150"/>
            <TableColumn fx:id="colPosition" text="Position" prefWidth="150"/>
            <TableColumn fx:id="colSalary" text="Salary" prefWidth="100"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button fx:id="btnLoadReport" text="Load Report" style="-fx-background-color: #0078D7; -fx-text-fill: white;"
                onAction="#handleLoadReport"/>
        <Button fx:id="btnExportPDF" text="Export to PDF" style="-fx-background-color: #0078D7; -fx-text-fill: white;"
                onAction="#exportToPDF"/>
    </HBox>

    <Label fx:id="outputMessage" textFill="red"/>
</VBox>
