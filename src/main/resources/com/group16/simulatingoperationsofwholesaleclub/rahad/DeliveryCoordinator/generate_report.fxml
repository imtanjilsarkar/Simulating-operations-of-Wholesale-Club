<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="645.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.rahad.DeliveryCoordinator.controller.GenerateDeliveryReportController">


    <Label layoutX="220.0" layoutY="10.0" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#004aad;" text="Delivery Report" />

    <Button layoutX="14.0" layoutY="320.0" onAction="#handleGenerateReport" prefWidth="140" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Generate Report" />
    <Button layoutX="178.0" layoutY="320.0" onAction="#handleDownloadReport" prefWidth="140" style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-background-radius:5;" text="Download Report" />

    <TableView fx:id="reportTable" layoutX="5.0" layoutY="49.0" prefHeight="254.0" prefWidth="684.0" style="-fx-border-color: #007bff; -fx-border-width: 1px;">
        <columns>
            <TableColumn fx:id="colOrderID" prefWidth="120" text="Order ID" />
            <TableColumn fx:id="colDriver" prefWidth="191.99998474121094" text="Driver Name" />
            <TableColumn fx:id="colStatus" prefWidth="186.4000244140625" text="Status" />
            <TableColumn fx:id="colDate" prefWidth="183.99993896484375" text="Delivery Date" />

        </columns>
    </TableView>

    <Label fx:id="statusLabel" layoutX="20.0" layoutY="368.0" prefWidth="580.0" text="" textFill="RED" wrapText="true" />

    <Button layoutX="10.0" layoutY="402.0" onAction="#handleBack" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5;" text="Back" />


</AnchorPane>
