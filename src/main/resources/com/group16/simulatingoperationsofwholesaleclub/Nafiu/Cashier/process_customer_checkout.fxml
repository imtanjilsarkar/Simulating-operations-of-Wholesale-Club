<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.nafiu.Cashier.Controller.Process_Customer_Checkout">

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="561.0" onAction="#handleBack" prefWidth="100.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Back" />

    <!-- Header -->
    <Label layoutX="160.0" layoutY="40.0" style="-fx-font-size: 22px; -fx-text-fill: #0078D7; -fx-font-weight: bold;" text="Process Customer Checkout" />

    <Line endX="600.0" layoutX="160.0" layoutY="80.0" stroke="#0078D7" strokeWidth="2" />

    <!-- Content Section -->
    <VBox layoutX="160.0" layoutY="120.0" spacing="20.0">

        <!-- Step 1: Start Checkout -->
        <Button onAction="#handleStartCheckout" prefWidth="300.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Start Checkout" />

        <!-- Step 2: Enter Product ID -->
        <VBox spacing="5.0">
            <Label style="-fx-text-fill: #0078D7; -fx-font-size: 14px; -fx-font-weight: bold;" text="Enter Product ID:" />
            <TextField fx:id="productIdField" prefWidth="300.0" />
            <Button onAction="#handleAddProduct" prefWidth="150.0" style="-fx-background-color: #005EA6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Add Product" />
        </VBox>

        <!-- Step 3: System Calculates Total Price -->
        <Label fx:id="totalPriceLabel" style="-fx-text-fill: #333; -fx-font-size: 16px;" text="Total Price: 0" />
   
        <!-- Step 4: Membership Check -->
        <Button onAction="#handleMembershipCheck" prefWidth="200.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6;" text="Check Membership" />
   
                 <!-- Step 5: Final Bill -->
        <Label fx:id="finalBillLabel" style="-fx-text-fill: #333; -fx-font-size: 16px;" text="Final Bill: 0" />

    </VBox>

</AnchorPane>
