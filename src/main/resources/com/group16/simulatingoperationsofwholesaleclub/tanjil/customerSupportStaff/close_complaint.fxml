<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group16.simulatingoperationsofwholesaleclub.tanjil.customerSupportStaff.controller.CloseComplaintController">

    <!-- Title -->
    <Label layoutX="280.0" layoutY="30.0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0078D7;" text="Close Complaint" />

    <!-- Customer Name -->
    <Label layoutX="100.0" layoutY="100.0" text="Customer Name:" />
    <TextField fx:id="customerNameField" layoutX="250.0" layoutY="95.0" prefWidth="300.0" />

    <!-- Search Button -->
    <Button layoutX="570.0" layoutY="95.0" onAction="#handleSearchComplaint" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Search" />

    <!-- Complaint List -->
    <Label layoutX="100.0" layoutY="150.0" text="Complaints:" />
    <TextArea fx:id="complaintListArea" editable="false" layoutX="250.0" layoutY="145.0" prefHeight="150.0" prefWidth="420.0" wrapText="true" />

    <!-- Complaint Title to Close -->
    <Label layoutX="100.0" layoutY="320.0" text="Complaint Title:" />
    <TextField fx:id="complaintTitleField" layoutX="250.0" layoutY="315.0" prefWidth="300.0" />

    <!-- Close Button -->
    <Button layoutX="250.0" layoutY="370.0" onAction="#handleCloseComplaint" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Close Complaint" />

    <!-- Cancel Button -->
    <Button layoutX="420.0" layoutY="370.0" onAction="#handleCancel" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #0078D7; -fx-text-fill: #0078D7; -fx-background-radius: 8;" text="Cancel" />

    <!-- Back Button -->
    <Button layoutX="14.0" layoutY="450.0" onAction="#handleBackCSD" prefHeight="18.0" prefWidth="51.0" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-background-radius: 8;" text="Back" />

    <!-- Message Label -->
    <Label fx:id="messageLabel" layoutX="250.0" layoutY="440.0" prefWidth="420.0" style="-fx-text-fill: #000000;" />

</AnchorPane>
